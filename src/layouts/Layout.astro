---
export interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = '/7days-to-die-wiki';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | 七日杀 Wiki</title>
  <meta name="description" content={description || title} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
  <script src={`${base}/pagefind/pagefind-ui.js`} defer></script>
  <style>
    :root {
      --c-brand: #b91c1c;
      --c-brand-hover: #991b1b;
      --c-brand-light: #fef2f2;
      --c-bg: #f5f5f5;
      --c-surface: #fff;
      --c-text: #1a1a2e;
      --c-text-2: #6b7280;
      --c-text-3: #9ca3af;
      --c-border: #e5e7eb;
      --c-border-light: #f3f4f6;
      --sidebar-w: 220px;
      --max-w: 1120px;
      --radius: 10px;
      --radius-sm: 6px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', system-ui, sans-serif;
      color: var(--c-text); background: var(--c-bg); line-height: 1.7; font-size: 15px;
    }
    a { color: var(--c-brand); text-decoration: none; }
    a:hover { color: var(--c-brand-hover); text-decoration: underline; }

    nav.top {
      background: var(--c-brand); padding: 0 20px; display: flex; gap: 6px;
      align-items: center; position: sticky; top: 0; z-index: 100;
      height: 48px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    nav.top a { color: rgba(255,255,255,0.9); padding: 4px 12px; border-radius: var(--radius-sm); font-size: 14px; font-weight: 500; transition: background 0.15s; white-space: nowrap; }
    nav.top a:hover { background: rgba(255,255,255,0.15); color: #fff; text-decoration: none; }
    nav.top .brand { font-size: 16px; font-weight: 700; margin-right: 8px; }
    #search { flex: 1; min-width: 140px; max-width: 280px; margin-left: auto; }
    .pagefind-ui { --pagefind-ui-scale: 0.75; --pagefind-ui-primary: #fff; --pagefind-ui-text: #fff; --pagefind-ui-background: rgba(255,255,255,0.12); --pagefind-ui-border: rgba(255,255,255,0.25); --pagefind-ui-font: inherit; }

    .wrapper { display: flex; max-width: var(--max-w); margin: 0 auto; min-height: calc(100vh - 120px); }

    aside { width: var(--sidebar-w); flex-shrink: 0; padding: 24px 0 24px 12px; display: none; }
    @media (min-width: 900px) { aside { display: block; } }
    aside h3 { font-size: 11px; color: var(--c-text-3); text-transform: uppercase; letter-spacing: 1.2px; margin: 20px 0 6px 10px; }
    aside a { display: block; padding: 5px 10px; font-size: 13px; color: var(--c-text); border-radius: var(--radius-sm); transition: all 0.12s; }
    aside a:hover { background: var(--c-border-light); color: var(--c-brand); text-decoration: none; }

    .container { flex: 1; padding: 28px 32px; max-width: 960px; overflow-x: auto; }
    h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 6px; color: var(--c-text); letter-spacing: -0.02em; }
    h2 { font-size: 1.25rem; font-weight: 600; margin: 28px 0 14px; color: var(--c-text); }
    h2:first-of-type { margin-top: 0; }
    p { margin-bottom: 10px; color: var(--c-text-2); line-height: 1.8; }
    .subtitle { font-size: 14px; color: var(--c-text-2); margin-bottom: 24px; }
    blockquote { border-left: 3px solid var(--c-brand); padding: 10px 18px; margin: 16px 0; background: #fafafa; color: var(--c-text-2); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
    .breadcrumb { font-size: 13px; color: var(--c-text-3); margin-bottom: 20px; }
    .breadcrumb a { color: var(--c-text-3); }
    .breadcrumb a:hover { color: var(--c-brand); text-decoration: underline; }

    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; margin: 20px 0; }
    .card {
      display: block; background: var(--c-surface); border: 1px solid var(--c-border);
      border-radius: var(--radius); padding: 22px 16px; text-align: center;
      transition: all 0.18s; text-decoration: none !important;
    }
    .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--c-brand); }
    .card .num { font-size: 2rem; font-weight: 800; color: var(--c-brand); display: block; line-height: 1.2; }
    .card .lbl { font-size: 13px; color: var(--c-text-2); margin-top: 4px; display: block; }

    .item-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px; margin: 16px 0 28px; }
    .item-grid a {
      display: block; padding: 6px 12px; font-size: 14px; color: var(--c-text);
      border-radius: var(--radius-sm); transition: all 0.12s;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .item-grid a:hover { background: var(--c-brand-light); color: var(--c-brand); text-decoration: none; }

    table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 14px; }
    th { background: var(--c-brand); color: #fff; padding: 9px 14px; text-align: left; font-weight: 600; font-size: 13px; }
    td, th { border: 1px solid var(--c-border); padding: 7px 14px; }
    tr:nth-child(even) { background: #fafafa; }
    ul { margin: 8px 0 8px 22px; }
    li { margin-bottom: 4px; }
    footer { text-align: center; padding: 24px; color: var(--c-text-3); font-size: 13px; border-top: 1px solid var(--c-border); background: var(--c-surface); }
	</style>
</head>
<body>
  <nav class="top">
    <a href={base} class="brand">七日杀 Wiki</a>
    <a href={`${base}/vanilla/items/`}>物品</a>
    <a href={`${base}/vanilla/recipes/`}>配方</a>
    <a href={`${base}/vanilla/skills/`}>技能</a>
    <a href={`${base}/vanilla/zombies/`}>僵尸</a>
    <div id="search"></div>
  </nav>
  <div class="wrapper">
    <aside>
      <h3>导航</h3>
      <a href={base}>🏠 首页</a>
      <h3>原版数据</h3>
      <a href={`${base}/vanilla/items/`}>🛠️ 物品</a>
      <a href={`${base}/vanilla/recipes/`}>📖 配方</a>
      <a href={`${base}/vanilla/skills/`}>⚡ 技能</a>
      <a href={`${base}/vanilla/zombies/`}>🧟 僵尸</a>
    </aside>
    <div class="container" data-pagefind-body>
      <slot />
    </div>
  </div>
  <footer>
    <p>基于 Astro 构建 · 数据来自 7 Days to Die 游戏文件 · <a href="https://github.com/mllllwb/7days-to-die-wiki">GitHub</a></p>
  </footer>
  <script>window.addEventListener('DOMContentLoaded',()=>{new PagefindUI({element:"#search",showImages:false,showEmptyQuery:false,baseUrl:"/7days-to-die-wiki/"});});</script>
</body>
</html>
