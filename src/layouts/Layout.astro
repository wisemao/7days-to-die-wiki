---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';

export interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title.includes('七日杀 Wiki') ? title : `${title} | 七日杀 Wiki`}</title>
  <meta name="description" content={description || title} />
  <link rel="canonical" href={`https://wisemao.github.io${Astro.url.pathname.replace(/\/$/, '')}/`} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <meta property="og:title" content={title.includes('七日杀 Wiki') ? title : `${title} | 七日杀 Wiki`} />
  <meta property="og:description" content={description || `${title} - 7 Days to Die 中文维基`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://wisemao.github.io${Astro.url.pathname}`} />
  <meta property="og:site_name" content="七日杀 Wiki" />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:image" content={`https://wisemao.github.io/7days-to-die-wiki/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title.includes('七日杀 Wiki') ? title : `${title} | 七日杀 Wiki`} />
  <meta name="twitter:description" content={description || `${title} - 7 Days to Die 中文维基`} />
  <link rel="stylesheet" href={`${base}/pagefind/pagefind-component-ui.css`} />
  <script is:inline type="module" src={`${base}/pagefind/pagefind-component-ui.js`} async></script>
  <script is:inline>
    (function() {
      var theme = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title.includes('七日杀 Wiki') ? title : `${title} | 七日杀 Wiki`,
    "description": description || title,
    "url": `https://wisemao.github.io${Astro.url.pathname.replace(/\/$/, '')}/`,
    "inLanguage": "zh-CN",
    "isPartOf": {
      "@type": "WebSite",
      "name": "七日杀 Wiki",
      "url": "https://wisemao.github.io/7days-to-die-wiki/"
    }
  })} />
  <style is:global>
    /* ═══════════════════════════════════════════
       🎨 7 Days to Die Wiki — Design System
       Inspired by the post-apocalyptic survival
       aesthetic: blood, rust, industry, decay.
       ═══════════════════════════════════════════ */

    :root {
      /* ─── Brand Core ─── */
      --c-blood:        #c62828;
      --c-blood-dark:   #8e1a1a;
      --c-blood-light:  #ffebee;
      --c-blood-glow:   rgba(198,40,40,0.12);

      /* ─── Rust / Earth ─── */
      --c-rust:         #8d6e63;
      --c-rust-dark:    #5d4037;
      --c-rust-light:   #d7ccc8;

      /* ─── Survival Accents ─── */
      --c-olive:        #5a7247;
      --c-amber:        #ff8f00;
      --c-steel:        #546e7a;

      /* ─── Light Mode ─── */
      --c-bg:           #f2efe9;
      --c-surface:      #ffffff;
      --c-surface-hover:#faf6f0;
      --c-text:         #2c2c2c;
      --c-text-2:       #5d5d5d;
      --c-text-3:       #999999;
      --c-border:       #ddd8d0;
      --c-border-light: #ede8e0;

      /* ─── Layout ─── */
      --sidebar-w: 220px;
      --max-w: 1140px;
      --radius: 10px;
      --radius-sm: 6px;

      /* ─── Shadows ─── */
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
      --shadow-lg: 0 8px 32px rgba(0,0,0,0.12);

      /* ─── Nav Sizes ─── */
      --nav-h: 52px;
    }

    /* ─── Dark Mode ─── */
    [data-theme="dark"] {
      --c-bg:           #161616;
      --c-surface:      #242424;
      --c-surface-hover:#2e2e2e;
      --c-text:         #e0e0e0;
      --c-text-2:       #a8a8a8;
      --c-text-3:       #707070;
      --c-border:       #333333;
      --c-border-light: #2a2a2a;
      --c-blood-light:  #2d1515;
      --c-blood-glow:   rgba(198,40,40,0.18);
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.4);
      --shadow-lg: 0 8px 32px rgba(0,0,0,0.5);
      color-scheme: dark;
    }

    /* ─── Reset ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─── Base ─── */
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', 'Noto Sans CJK SC', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
      color: var(--c-text);
      background: var(--c-bg);
      line-height: 1.7;
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--c-blood); text-decoration: none; transition: color 0.15s; }
    a:hover { color: var(--c-blood-dark); text-decoration: underline; }
    img { max-width: 100%; height: auto; }

    /* ─── Skip to content (accessibility) ─── */
    .skip-link {
      position: fixed; top: -100%; left: 12px; z-index: 9999;
      background: var(--c-blood); color: #fff; padding: 8px 16px;
      border-radius: var(--radius-sm); font-size: 14px; font-weight: 600;
      transition: top 0.2s;
    }
    .skip-link:focus { top: 8px; }

    /* ═══════════════════════════════════════════
       LAYOUT
       ═══════════════════════════════════════════ */

    .wrapper {
      display: flex;
      max-width: var(--max-w);
      margin: 0 auto;
      min-height: calc(100vh - var(--nav-h) - 60px);
    }

    /* ─── Sidebar Overlay (bridges Nav toggle + Sidebar) ─── */
    .sidebar-overlay { display: none; }
    .sidebar-overlay.show { display: block; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 98; }

    /* ─── Main Content ─── */
    .container {
      flex: 1;
      padding: 32px 36px;
      max-width: 960px;
      overflow-x: auto;
      min-width: 0;
    }
    @media (max-width: 600px) {
      .container { padding: 20px 16px; }
    }

    /* ═══════════════════════════════════════════
       TYPOGRAPHY
       ═══════════════════════════════════════════ */

    h1 {
      font-size: 1.85rem;
      font-weight: 800;
      margin-bottom: 8px;
      color: var(--c-text);
      letter-spacing: -0.03em;
      line-height: 1.25;
    }
    h2 {
      font-size: 1.3rem;
      font-weight: 700;
      margin: 32px 0 14px;
      color: var(--c-text);
      padding-bottom: 6px;
      border-bottom: 2px solid var(--c-blood);
      display: inline-block;
    }
    h2:first-of-type { margin-top: 0; }
    h3 {
      font-size: 1.05rem;
      font-weight: 600;
      margin: 24px 0 10px;
      color: var(--c-text);
    }
    p { margin-bottom: 12px; color: var(--c-text-2); line-height: 1.8; }
    .subtitle { font-size: 14px; color: var(--c-text-3); margin-bottom: 28px; }

    /* ─── Breadcrumb ─── */
    .breadcrumb {
      font-size: 13px;
      color: var(--c-text-3);
      margin-bottom: 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }
    .breadcrumb a { color: var(--c-text-3); }
    .breadcrumb a:hover { color: var(--c-blood); text-decoration: underline; }
    .breadcrumb .sep { color: var(--c-text-3); opacity: 0.4; }

    /* ─── Blockquote ─── */
    blockquote {
      border-left: 3px solid var(--c-blood);
      padding: 12px 20px;
      margin: 20px 0;
      background: var(--c-blood-light);
      color: var(--c-text-2);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }

    /* ═══════════════════════════════════════════
       COMPONENTS
       ═══════════════════════════════════════════ */

    /* ─── Card Grid ─── */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 14px;
      margin: 20px 0;
    }
    .card {
      display: block;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 20px 14px;
      text-align: center;
      transition: all 0.2s;
      text-decoration: none !important;
      position: relative;
      overflow: hidden;
    }
    .card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--c-blood);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--c-rust-light);
    }
    .card:hover::before { transform: scaleX(1); }
    .card .num {
      font-size: 2rem;
      font-weight: 800;
      color: var(--c-blood);
      display: block;
      line-height: 1.2;
    }
    .card .lbl {
      font-size: 13px;
      color: var(--c-text-2);
      margin-top: 6px;
      display: block;
    }

    /* ─── Item Grid ─── */
    .item-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 4px;
      margin: 16px 0 28px;
    }
    .item-grid a {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      font-size: 14px;
      color: var(--c-text);
      border-radius: var(--radius-sm);
      transition: all 0.12s;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-decoration: none !important;
    }
    .item-grid a::before {
      content: '';
      width: 4px; height: 4px;
      border-radius: 50%;
      background: var(--c-rust);
      flex-shrink: 0;
      opacity: 0.4;
    }
    .item-grid a:hover { background: var(--c-blood-glow); color: var(--c-blood); }
    .item-grid a:hover::before { background: var(--c-blood); opacity: 1; }

    /* ─── Entity Grid (list pages with meta info) ─── */
    .entity-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 8px;
      margin: 16px 0 28px;
    }
    .entity-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 10px 16px;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      transition: all 0.15s;
      text-decoration: none !important;
    }
    .entity-item:hover {
      border-color: var(--c-blood);
      background: var(--c-blood-light);
      transform: translateY(-1px);
    }
    .entity-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--c-text);
    }
    .entity-meta {
      font-size: 12px;
      color: var(--c-text-3);
      line-height: 1.5;
    }

    /* ─── Table ─── */
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
      font-size: 14px;
      border-radius: var(--radius-sm);
      overflow: hidden;
    }
    caption {
      /* Visually hidden but accessible to screen readers */
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    th {
      background: var(--c-blood);
      color: #fff;
      padding: 10px 16px;
      text-align: left;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.3px;
    }
    th:last-child { text-align: right; }
    td, th { border: 1px solid var(--c-border); padding: 8px 16px; }
    tr:nth-child(even) { background: var(--c-blood-light); }
    tr:hover { background: var(--c-blood-glow); }

    /* ─── Lists ─── */
    ul { margin: 10px 0 10px 24px; }
    li { margin-bottom: 5px; line-height: 1.6; }

    /* ─── Collapsible ─── */
    .collapsible {
      cursor: pointer;
      user-select: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .collapsible:hover { opacity: 0.8; }
    .collapsible .arrow {
      display: inline-block;
      transition: transform 0.2s;
      font-size: 11px;
      color: var(--c-text-3);
    }
    .collapsible.collapsed .arrow { transform: rotate(-90deg); }
    .collapse-content { overflow: hidden; transition: max-height 0.25s ease; }
    .collapse-content.collapsed { max-height: 0 !important; }

    /* ─── Back to Top ─── */
    .back-to-top {
      position: fixed; bottom: 32px; right: 32px;
      width: 44px; height: 44px;
      border-radius: 50%;
      background: var(--c-blood);
      color: #fff;
      border: none;
      font-size: 20px;
      cursor: pointer;
      box-shadow: var(--shadow-md);
      transition: all 0.2s;
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .back-to-top.visible {
      opacity: 1;
      pointer-events: auto;
    }
    .back-to-top:hover {
      background: var(--c-blood-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    /* ─── Info Card (used in book-series etc) ─── */
    .info-card {
      margin-top: 32px;
      padding: 24px;
      background: var(--c-blood-light);
      border: 2px solid var(--c-blood);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }

    /* ─── Stars (item quality) ─── */
    .stars { font-size: 16px; letter-spacing: 2px; color: #ff8f00; }

    /* ═══════════════════════════════════════════
       ACCESSIBILITY
       ═══════════════════════════════════════════ */

    :focus-visible {
      outline: 2px solid var(--c-blood);
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      html { scroll-behavior: auto; }
    }

    /* ═══════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════ */

    @media (max-width: 599px) {
      h1 { font-size: 1.5rem; }
      .card-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
      .item-grid { grid-template-columns: 1fr; }
      .back-to-top { bottom: 20px; right: 20px; width: 40px; height: 40px; }
    }

    /* ─── Item detail page: icon ─── */
    .item-header {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      margin-bottom: 24px;
    }
    .item-header .icon {
      width: 80px; height: 80px;
      flex-shrink: 0;
      border-radius: var(--radius);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px;
      box-shadow: var(--shadow-sm);
    }
    .item-header .icon img {
      width: 100%; height: 100%;
      object-fit: contain;
    }
    .item-header .meta { flex: 1; }
    .item-header .meta h1 { margin-bottom: 4px; }
    .item-header .meta .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    .item-header .meta .tag {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      background: var(--c-blood-light);
      color: var(--c-blood);
      border: 1px solid var(--c-blood);
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">跳转到主要内容</a>

  <Nav base={base} />

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="wrapper">
    <Sidebar base={base} />
    <div class="container" data-pagefind-body id="main-content">
      <slot />
    </div>
  </div>

  <button class="back-to-top" id="backToTop" aria-label="返回顶部">↑</button>

  <Footer base={base} />

  <pagefind-modal></pagefind-modal>

  <script>
  window.addEventListener('DOMContentLoaded', () => {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');

    /* ─── Pagefind Component UI auto-initializes via <pagefind-modal-trigger> ─── */

    /* ─── Collapsible Sections ─── */
    document.querySelectorAll<HTMLElement>('.collapsible').forEach((btn, i) => {
      const target = btn.nextElementSibling!;
      target.classList.add('collapse-content');
      // Accessibility: set up role, tabindex, aria attributes
      btn.setAttribute('role', 'button');
      btn.setAttribute('tabindex', '0');
      if (!target.id) target.id = 'collapse-target-' + i;
      btn.setAttribute('aria-controls', target.id);
      btn.setAttribute('aria-expanded', String(!btn.classList.contains('collapsed')));
      // Wrap content text in arrow span
      const arrow = document.createElement('span');
      arrow.className = 'arrow';
      arrow.textContent = '▼';
      btn.prepend(arrow);
      function toggleCollapse() {
        const isCollapsed = btn.classList.toggle('collapsed');
        target.classList.toggle('collapsed');
        btn.setAttribute('aria-expanded', String(!isCollapsed));
      }
      btn.addEventListener('click', toggleCollapse);
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleCollapse(); }
      });
    });

    /* ─── Mobile Nav Toggle ─── */
    const navToggle = document.getElementById('navToggle');
    const sidebar = document.getElementById('sidebar')!;
    const overlay = document.getElementById('sidebarOverlay')!;
    if (navToggle && sidebar && overlay) {
      function closeSidebar() {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
      }
      navToggle.addEventListener('click', () => {
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
      });
      overlay.addEventListener('click', closeSidebar);
      // Close on escape
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') closeSidebar();
      });
    }

    /* ─── Back to Top ─── */
    const backBtn = document.getElementById('backToTop');
    if (backBtn) {
      const toggleVisible = () => {
        backBtn.classList.toggle('visible', window.scrollY > 300);
      };
      window.addEventListener('scroll', toggleVisible, { passive: true });
      backBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    /* ─── Dark Mode Toggle ─── */
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const themeLabel = document.getElementById('themeLabel');
    if (themeToggle) {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = stored ? stored === 'dark' : prefersDark;
      if (isDark) document.documentElement.setAttribute('data-theme', 'dark');
      updateThemeUI(isDark);

      themeToggle.addEventListener('click', () => {
        const now = document.documentElement.getAttribute('data-theme') === 'dark';
        const next = !now;
        document.documentElement.setAttribute('data-theme', next ? 'dark' : '');
        localStorage.setItem('theme', next ? 'dark' : 'light');
        updateThemeUI(next);
      });

      function updateThemeUI(dark: boolean) {
        if (themeIcon) themeIcon.textContent = dark ? '🌙' : '☀️';
        if (themeLabel) themeLabel.textContent = dark ? '亮色' : '深色';
      }
    }

    /* ─── Active Nav Highlight ─── */
    const currentPath = window.location.pathname.replace(base, '') || '/';
    document.querySelectorAll('nav.top a, aside a').forEach(a => {
      const href = a.getAttribute('href') || '';
      // Remove leading base from href for comparison
      const cleanHref = href.replace(base, '') || '/';
      let isActive = false;
      if (currentPath.startsWith(cleanHref) && cleanHref !== '/') {
        isActive = true;
      } else if (currentPath === '/' && cleanHref === '/') {
        isActive = true;
      }
      if (isActive) {
        a.classList.add('active');
        a.setAttribute('aria-current', 'page');
      }
    });
  });
  </script>
</body>
</html>
