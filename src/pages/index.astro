---
import Layout from '../layouts/Layout.astro';
import { loadData, ITEM_CATEGORY_LABELS, STATION_LABELS } from '../utils/data-loader';
import { categoryIconUrl } from '../utils/item-icons';
const { items, recipes, skills, zombies, blocks, biomes } = loadData();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catCounts = {};
for (const item of items) {
  const label = ITEM_CATEGORY_LABELS[item.category] || item.category;
  catCounts[label] = (catCounts[label] || 0) + 1;
}
const catCards = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const labelToKey = {};
for (const item of items) {
  const label = ITEM_CATEGORY_LABELS[item.category] || item.category;
  if (!labelToKey[label]) labelToKey[label] = item.category;
}

// Category representative icon per card
const catIcons = {};
for (const item of items) {
  const label = ITEM_CATEGORY_LABELS[item.category] || item.category;
  if (!catIcons[label]) catIcons[label] = categoryIconUrl(item.category, base);
}

// Hero section icons for the 4 main navigation cards
const HERO_ICONS = {
  items: categoryIconUrl('ranged_weapon', base),
  recipes: `${base}/images/items/forge.png`,
  skills: categoryIconUrl('book', base),
  zombies: `${base}/images/items/armorZombieMaskHelmet.png`,
};

// Hero showcase strip: signature items across categories
const SHOWCASE = [
  'meleeToolRepairT0StoneAxe', 'gunHandgunT1Pistol', 'foodCanBeef', 'medicalFirstAidKit',
  'resourceForgedIron', 'meleeWpnBladeT1HuntingKnife', 'modGunScopeMedium', 'meleeWpnSledgeT1IronSledgehammer',
].map(id => `${base}/images/items/${id}.png`);

// Station counts for quick insight
const STATION_ICONS = {
  backpack: 'meleeToolRepairT0StoneAxe',
  workbench: 'meleeToolRepairT1ClawHammer',
  forge: 'forge',
  campfire: 'foodGrilledMeat',
  chemistry: 'drugPainkillers',
  concrete: 'cementMixer',
};
const stationCounts = {};
for (const r of recipes) {
  const slug = Object.entries(STATION_LABELS).find(([,v]) => v === r.station)?.[0] || 'backpack';
  if (!stationCounts[slug]) stationCounts[slug] = { slug, count: 0, icon: `${base}/images/items/${STATION_ICONS[slug]}.png` };
  stationCounts[slug].count++;
}

// Book series count
const bookItems = items.filter(i => i.category === 'book');
const extractSeries = (chn) => chn.replace(/[ 　]*第\s*\d+\s*[卷册][\s\S]*$/, '').replace(/[ 　]*卷\s*\d+[\s\S]*$/, '').trim();
const seriesSet = new Set();
for (const b of bookItems) {
  if (/^book/.test(b.id) || /^questReward/.test(b.id)) {
    seriesSet.add(extractSeries(b.name || b.id));
  }
}
const seriesCount = seriesSet.size;
---

<Layout title="七日杀 Wiki" description="7 Days to Die 中文维基 — 快速查询物品、配方、技能、丧尸信息">
  <!-- Hero -->
  <div class="hero">
    <h1 class="hero-title">七日杀 <span class="hero-highlight">Wiki</span></h1>
    <p class="hero-sub">7 Days to Die 中文资料库 · 快速查阅物品、配方、技能与丧尸数据</p>
    <div class="hero-showcase">
      {SHOWCASE.map(src => <img class="showcase-icon" src={src} alt="" loading="lazy" />)}
    </div>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">{items.length}</span>
        <span class="hero-stat-lbl">物品</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">{recipes.length}</span>
        <span class="hero-stat-lbl">配方</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">{skills.length}</span>
        <span class="hero-stat-lbl">技能</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">{zombies.length}</span>
        <span class="hero-stat-lbl">丧尸</span>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="card-grid">
    <a href={`${base}/vanilla/items/`} class="card">
      {HERO_ICONS.items && <img class="card-icon" src={HERO_ICONS.items} alt="" loading="lazy" />}
      <span class="num">{items.length}</span>
      <span class="lbl">物品 · 工具 · 武器 · 护甲</span>
    </a>
    <a href={`${base}/vanilla/recipes/`} class="card">
      {HERO_ICONS.recipes && <img class="card-icon" src={HERO_ICONS.recipes} alt="" loading="lazy" />}
      <span class="num">{recipes.length}</span>
      <span class="lbl">配方 · 合成 · 熔炉 · 工作台</span>
    </a>
    <a href={`${base}/vanilla/skills/`} class="card">
      {HERO_ICONS.skills && <img class="card-icon" src={HERO_ICONS.skills} alt="" loading="lazy" />}
      <span class="num">{skills.length}</span>
      <span class="lbl">技能 · 5 系属性 · Perk</span>
    </a>
    <a href={`${base}/vanilla/zombies/`} class="card">
      {HERO_ICONS.zombies && <img class="card-icon" src={HERO_ICONS.zombies} alt="" loading="lazy" />}
      <span class="num">{zombies.length}</span>
      <span class="lbl">丧尸 · 图鉴 · 掉落 · 弱点</span>
    </a>
    <a href={`${base}/vanilla/blocks/`} class="card">
      <img class="card-icon" src={`${base}/images/items/bladeTrap.png`} alt="" loading="lazy" />
      <span class="num">{blocks.length}</span>
      <span class="lbl">防御方块 · 陷阱 · 炮塔 · 电力</span>
    </a>
    <a href={`${base}/vanilla/biomes/`} class="card">
      <img class="card-icon" src={`${base}/images/items/resourceClayLump.png`} alt="" loading="lazy" />
      <span class="num">{biomes.length}</span>
      <span class="lbl">生物群系 · 资源 · 天气 · 难度</span>
    </a>
  </div>

  <h2>物品分类</h2>
  <div class="card-grid">
    {catCards.map(([k, v]) => (
      <a href={`${base}/vanilla/items/category/${labelToKey[k] || k}/`} class="card">
        {catIcons[k] && <img class="card-icon" src={catIcons[k]} alt="" loading="lazy" />}
        <span class="num">{v}</span>
        <span class="lbl">{k}</span>
      </a>
    ))}
  </div>

  <!-- Recipe Stations -->
  <h2>工作站速览</h2>
  <div class="card-grid">
    {Object.entries(stationCounts).map(([slug, s]) => (
      <a href={`${base}/vanilla/recipes/station/${slug}/`} class="card">
        {s.icon && <img class="card-icon" src={s.icon} alt="" loading="lazy" />}
        <span class="num">{s.count}</span>
        <span class="lbl">{STATION_LABELS[slug] || slug}</span>
      </a>
    ))}
  </div>

  <!-- Skill Books -->
  <h2>技能书系列</h2>
  <div class="quick-start">
    <p>共 <strong>{seriesCount}</strong> 个技能书系列，<strong>{bookItems.length}</strong> 卷书籍。阅读全套解锁强力加成。</p>
    <div class="quick-links">
      <a href={`${base}/vanilla/items/category/book/`} class="quick-badge" style="--badge-clr: var(--c-blood);">📚 浏览全部书籍</a>
      <a href={`${base}/vanilla/items/category/book/#技能杂志`} class="quick-badge" style="--badge-clr: var(--c-amber);">📘 技能杂志</a>
      <a href={`${base}/vanilla/items/category/book/#技能书`} class="quick-badge" style="--badge-clr: var(--c-olive);">📖 技能书系列</a>
    </div>
  </div>

  <h2>关于本站</h2>
  <div class="quick-start">
    <p>所有数据来自 7 Days to Die 游戏源文件自动生成：{items.length} 物品（含 104 模组）、{recipes.length} 配方、{skills.length} 技能（100% 中文）、{zombies.length} 丧尸、{blocks.length} 防御方块、{biomes.length} 生物群系，附 1589 个游戏图标。使用顶部搜索框快速查找（Ctrl+K），或通过分类浏览。</p>
    <div class="quick-links">
      <span class="quick-badge" style="--badge-clr: var(--c-blood);">🎯 按分类浏览</span>
      <span class="quick-badge" style="--badge-clr: var(--c-amber);">🔍 全文搜索</span>
      <span class="quick-badge" style="--badge-clr: var(--c-olive);">🔄 数据自动同步</span>
      <a href="https://github.com/wisemao/7days-to-die-wiki" class="quick-badge" style="--badge-clr: var(--c-steel);">⭐ GitHub 贡献</a>
    </div>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 40px 0 24px;
  }
  .hero-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -0.03em;
    color: var(--c-text);
  }
  .hero-highlight {
    color: var(--c-blood);
  }
  .hero-sub {
    font-size: 15px;
    color: var(--c-text-3);
    margin-bottom: 20px;
  }
  .hero-showcase {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .showcase-icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 10px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    padding: 4px;
    transition: transform 0.15s, border-color 0.15s;
  }
  .showcase-icon:hover {
    transform: translateY(-3px) scale(1.08);
    border-color: var(--c-blood);
  }
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-stat-num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--c-blood);
    line-height: 1.2;
  }
  .hero-stat-lbl {
    font-size: 13px;
    color: var(--c-text-3);
    margin-top: 2px;
  }
  .quick-start {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 20px 24px;
    margin: 20px 0;
  }
  .card-icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
    margin: 0 auto 8px;
    display: block;
    border-radius: 8px;
    background: var(--c-surface-2);
    padding: 4px;
  }
  .quick-start p {
    margin-bottom: 14px;
    color: var(--c-text-2);
    font-size: 14px;
    line-height: 1.8;
  }
  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .quick-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    background: color-mix(in srgb, var(--badge-clr) 12%, transparent);
    color: var(--badge-clr);
    border: 1px solid color-mix(in srgb, var(--badge-clr) 30%, transparent);
    text-decoration: none !important;
    transition: all 0.15s;
  }
  .quick-badge:hover {
    background: color-mix(in srgb, var(--badge-clr) 20%, transparent);
    transform: translateY(-1px);
  }

  @media (max-width: 599px) {
    .hero-title { font-size: 1.6rem; }
    .hero-stats { gap: 20px; }
    .hero-stat-num { font-size: 1.4rem; }
  }
</style>
