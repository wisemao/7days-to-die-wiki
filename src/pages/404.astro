---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="页面未找到" description="404 - 页面不存在">
  <div class="not-found" data-pagefind-ignore>
    <div class="not-found__code">404</div>
    <div class="not-found__title">这片区域尚未探索</div>
    <p class="not-found__desc">
      你寻找的页面不存在，或者它已在末世中失落。试试搜索或从首页重新开始。
    </p>
    <div class="not-found__actions">
      <a href={base} class="not-found__btn not-found__btn--primary">
        ← 返回首页
      </a>
      <a href={`${base}/vanilla/items/`} class="not-found__btn not-found__btn--secondary">
        浏览物品
      </a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 60px 20px;
  }
  .not-found__code {
    font-size: 80px;
    font-weight: 800;
    color: var(--c-blood);
    line-height: 1;
    margin-bottom: 8px;
  }
  .not-found__title {
    font-size: 20px;
    font-weight: 600;
    color: var(--c-text);
    margin-bottom: 8px;
  }
  .not-found__desc {
    color: var(--c-text-3);
    max-width: 360px;
    margin: 0 auto 28px;
  }
  .not-found__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .not-found__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none !important;
  }
  .not-found__btn--primary {
    background: var(--c-blood);
    color: #fff;
    transition: background 0.15s;
  }
  .not-found__btn--primary:hover {
    background: var(--c-blood-dark);
  }
  .not-found__btn--secondary {
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-border);
    font-weight: 500;
    transition: all 0.15s;
  }
  .not-found__btn--secondary:hover {
    background: var(--c-surface-hover);
    border-color: var(--c-rust-light);
  }
</style>
