---
import Layout from '../../../../layouts/Layout.astro';
import { loadData, ZOMBIE_TYPE_LABELS, ZOMBIE_TYPE_MAP } from '../../../../utils/data-loader';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const { zombies } = loadData();
  const groups = {};
  for (const z of zombies) {
    const slug = ZOMBIE_TYPE_MAP[z.category] || 'other';
    if (!groups[slug]) groups[slug] = [];
    groups[slug].push(z);
  }
  return Object.entries(groups).map(([slug, list]) => ({
    params: { type: slug },
    props: { zombieList: list.sort((a, b) => (a.name||a.id).localeCompare(b.name||b.id, 'zh')), typeSlug: slug },
  }));
}
const { zombieList, typeSlug } = Astro.props;
const typeLabel = ZOMBIE_TYPE_LABELS[typeSlug] || typeSlug;
function fmtHp(hp) {
  if (hp == null) return '-';
  if (typeof hp === 'number') return String(hp);
  const s = String(hp).trim();
  if (s.startsWith('^')) return '?';
  return s;
}
---

<Layout title={typeLabel} description={`${typeLabel} - ${zombieList.length} 个丧尸`}>
  <nav class="breadcrumb"><a href={base}>首页</a><span class="sep">/</span><a href={`${base}/vanilla/zombies/`}>丧尸列表</a><span class="sep">/</span><span>{typeLabel}</span></nav>
  <h1>{typeLabel}</h1>
  <p class="subtitle">共 {zombieList.length} 个丧尸</p>
  <div class="entity-grid">
    {zombieList.map(z => (
      <a href={`${base}/vanilla/zombies/${z._sanitizedId}/`} class="entity-item">
        <span class="entity-name">{z.name || z.id}</span>
        <span class="entity-meta">
          HP {fmtHp(z.hp)} · 移速 {z.speed?.run ?? '-'} · 伤害 {z.damage?.melee ?? '-'}
        </span>
      </a>
    ))}
  </div>

</Layout>
