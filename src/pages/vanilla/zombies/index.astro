---
import Layout from '../../../layouts/Layout.astro';
import { loadData, ZOMBIE_CATEGORY_LABELS } from '../../../utils/data-loader';
const { zombies } = loadData();
const base = '/7days-to-die-wiki';

const TYPE_MAP = [
  ['humanoid', '人形'],
  ['animal', '动物'],
  ['other', '其他'],
];
const cats = {};
for (const z of zombies) {
  const label = ZOMBIE_CATEGORY_LABELS[z.category] || z.category || '其他';
  const slug = TYPE_MAP.find(([,l]) => l === label)?.[0] || 'other';
  if (!cats[slug]) cats[slug] = { slug, label, count: 0 };
  cats[slug].count++;
}
const order = ['humanoid', 'animal', 'other'];
const catList = order.filter(s => cats[s]).map(s => cats[s]);
---

<Layout title="僵尸列表" description={`${zombies.length} 个僵尸`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a> / <span>僵尸列表</span>
  </nav>
  <h1>僵尸列表</h1>
  <p class="subtitle">共 {zombies.length} 个僵尸 · 选择类型浏览</p>
  <div class="card-grid">
    {catList.map(c => (
      <a href={`${base}/vanilla/zombies/type/${c.slug}/`} class="card">
        <span class="num">{c.count}</span>
        <span class="lbl">{c.label}</span>
      </a>
    ))}
  </div>
</Layout>
