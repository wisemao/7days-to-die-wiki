---
import Layout from '../../../layouts/Layout.astro';
import { loadData, sanitizeId } from '../../../utils/data-loader';
export function getStaticPaths() {
  const { recipes, itemMap } = loadData();
  return recipes.map(r => ({ params: { id: r._sanitizedId }, props: { recipe: r, itemMap } }));
}
const { recipe, itemMap } = Astro.props;
const base = '/7days-to-die-wiki';
const resolveName = (id) => itemMap.get(id)?.name || id;
const hasRecipe = recipe.recipe && recipe.recipe.length > 0;
const hasScrap = recipe.scrappable_into && recipe.scrappable_into.length > 0;
const craftsItem = itemMap.get(recipe.id);
---

<Layout title={recipe.name} description={`${recipe.name} - 合成配方`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><a href={`${base}/vanilla/recipes/`}>配方列表</a><span class="sep">/</span><span>{recipe.name}</span>
  </nav>
  <h1>{recipe.name}</h1>
  <p><strong>工作站:</strong> {recipe.station || '背包合成'} | <strong>耗时:</strong> {recipe.craft_time || 0}秒 | <strong>产出:</strong> {recipe.craft_count ?? 1}</p>
  {craftsItem && <p><strong>产出物品:</strong> <a href={`${base}/vanilla/items/${sanitizeId(recipe.id)}/`}>{craftsItem.name}</a></p>}

  {hasRecipe && (<>
    <h2>配方材料</h2>
    <ul>{recipe.recipe.filter(m => m.count > 0).map(m => <li><a href={`${base}/vanilla/items/${sanitizeId(m.item_id)}/`}>{resolveName(m.item_id)}</a> x{m.count}</li>)}</ul>
  </>)}
  {!hasRecipe && !hasScrap && <blockquote>此物品无法直接合成，需要从游戏中获取</blockquote>}

  {hasScrap && (<>
    <h2>分解获得</h2>
    <ul>{recipe.scrappable_into.map(s => <li><a href={`${base}/vanilla/items/${sanitizeId(s.item_id)}/`}>{resolveName(s.item_id)}</a> x{s.count}</li>)}</ul>
  </>)}
</Layout>
