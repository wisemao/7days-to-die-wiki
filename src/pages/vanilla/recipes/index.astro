---
import Layout from '../../../layouts/Layout.astro';
import { loadData, STATION_LABELS } from '../../../utils/data-loader';
const { recipes } = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function findSlug(raw) {
  if (!raw) return 'backpack';
  for (const [slug, label] of Object.entries(STATION_LABELS)) {
    if (label === raw) return slug;
  }
  return 'backpack';
}
function findLabel(slug) {
  return STATION_LABELS[slug] || slug;
}
const stations = {};
for (const r of recipes) {
  const slug = findSlug(r.station);
  if (!stations[slug]) stations[slug] = { slug, label: findLabel(slug), count: 0 };
  stations[slug].count++;
}
const stList = Object.values(stations);
const order = ['backpack', 'workbench', 'forge', 'campfire', 'chemistry', 'concrete'];
stList.sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---

<Layout title="配方列表" description={`${recipes.length} 个配方`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><span>配方列表</span>
  </nav>
  <h1>配方列表</h1>
  <p class="subtitle">共 {recipes.length} 个配方 · 选择工作站浏览</p>
  <div class="card-grid">
    {stList.map(s => (
      <a href={`${base}/vanilla/recipes/station/${s.slug}/`} class="card">
        <span class="num">{s.count}</span>
        <span class="lbl">{s.label}</span>
      </a>
    ))}
  </div>
</Layout>
