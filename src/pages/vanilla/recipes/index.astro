---
import Layout from '../../../layouts/Layout.astro';
import { loadData, STATION_LABELS } from '../../../utils/data-loader';
const { recipes } = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Station representative icons (fallback to signature craft items)
const STATION_ICONS: Record<string, string> = {
  backpack: 'meleeToolRepairT0StoneAxe',
  workbench: 'meleeToolRepairT1ClawHammer',
  forge: 'forge',
  campfire: 'foodGrilledMeat',
  chemistry: 'drugPainkillers',
  concrete: 'cementMixer',
};

function findSlug(raw?: string) {
  if (!raw) return 'backpack';
  for (const [slug, label] of Object.entries(STATION_LABELS)) {
    if (label === raw) return slug;
  }
  return 'backpack';
}
function findLabel(slug: string) {
  return STATION_LABELS[slug] || slug;
}
const stations: Record<string, { slug: string; label: string; count: number; icon: string | null }> = {};
for (const r of recipes) {
  const slug = findSlug(r.station);
  if (!stations[slug]) stations[slug] = { slug, label: findLabel(slug), count: 0, icon: STATION_ICONS[slug] ? `${base}/images/items/${STATION_ICONS[slug]}.png` : null };
  stations[slug].count++;
}
const stList = Object.values(stations);
const order = ['backpack', 'workbench', 'forge', 'campfire', 'chemistry', 'concrete'];
stList.sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---

<Layout title="配方列表" description={`${recipes.length} 个配方`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><span>配方列表</span>
  </nav>
  <h1>配方列表</h1>
  <p class="subtitle">共 {recipes.length} 个配方 · 选择工作站浏览</p>
  <div class="card-grid">
    {stList.map(s => (
      <a href={`${base}/vanilla/recipes/station/${s.slug}/`} class="card">
        {s.icon && <img class="card-icon" src={s.icon} alt="" loading="lazy" />}
        <span class="num">{s.count}</span>
        <span class="lbl">{s.label}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .card-icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
    margin: 0 auto 8px;
    display: block;
    border-radius: 8px;
    background: var(--c-surface-2);
    padding: 4px;
  }
</style>
