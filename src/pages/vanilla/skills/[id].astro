---
import Layout from '../../../layouts/Layout.astro';
import { loadData, sanitizeId } from '../../../utils/data-loader';
export function getStaticPaths() {
  const { skills } = loadData();
  return skills.map(s => ({ params: { id: s._sanitizedId }, props: { skill: s } }));
}
const { skill } = Astro.props;
const { ATTR_LABELS, resolveItemName } = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catLabel = ATTR_LABELS[skill.category] || skill.category;
const hasLevels = skill.levels && skill.levels.length > 0;
const hasBooks = skill.tied_books && skill.tied_books.length > 0;
---

<Layout title={skill.name} description={`${skill.name} - ${catLabel}技能，最高${skill.max_level}级`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><a href={`${base}/vanilla/skills/`}>技能列表</a><span class="sep">/</span><span>{skill.name}</span>
  </nav>
  <h1>{skill.name}</h1>
  <p><strong>属性:</strong> {catLabel} | <strong>最高等级:</strong> {skill.max_level}</p>
  {skill.description && <p><strong>描述:</strong> {skill.description.replace(/\[[A-F0-9]{6}\]|\[\-\]/g, '').split('\\n').map((line, i) => <span>{i > 0 && <br/>}{line}</span>)}</p>}

  {hasLevels && (<>
    <h2>等级效果</h2>
    <table><caption style="caption-side:bottom;font-size:12px;color:var(--c-text-3);padding-top:4px;">{skill.name} 各等级效果与消耗</caption><tr><th scope="col">等级</th><th scope="col">效果</th><th scope="col">消耗技能点</th></tr>
      {skill.levels.map(l => <tr><td>{l.level}</td><td>{l.effect}</td><td>{l.cost}</td></tr>)}
    </table>
  </>)}

  {hasBooks && (<>
    <h2>关联书籍</h2>
    <table><caption style="caption-side:bottom;font-size:12px;color:var(--c-text-3);padding-top:4px;">{skill.name} 关联的技能书籍</caption><tr><th scope="col">书籍</th><th scope="col">效果</th></tr>
      {skill.tied_books.map(b => <tr><td><a href={`${base}/vanilla/items/${sanitizeId(b.book_id)}/`}>{resolveItemName(b.book_id) || b.book_id}</a></td><td>{b.effect}</td></tr>)}
    </table>
  </>)}
</Layout>
