---
import Layout from '../../../../layouts/Layout.astro';
import { loadData, ATTR_SLUG_MAP, SLUG_TO_ATTR_LABEL, type Skill } from '../../../../utils/data-loader';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const { skills } = loadData();
  const groups: Record<string, Skill[]> = {};
  for (const s of skills) {
    const slug = Object.entries(ATTR_SLUG_MAP).find(([,v]) => v === s.category)?.[0] || 'general';
    if (!groups[slug]) groups[slug] = [];
    groups[slug].push(s);
  }
  return Object.entries(groups).map(([slug, list]) => ({
    params: { attr: slug },
    props: { skillList: list.sort((a, b) => (a.name||a.id).localeCompare(b.name||b.id, 'zh')), attrSlug: slug },
  }));
}
const { skillList, attrSlug } = Astro.props;
const attrLabel = SLUG_TO_ATTR_LABEL[attrSlug] || attrSlug;
---

<Layout title={attrLabel} description={`${attrLabel} - ${skillList.length} 个技能`}>
  <nav class="breadcrumb"><a href={base}>首页</a><span class="sep">/</span><a href={`${base}/vanilla/skills/`}>技能列表</a><span class="sep">/</span><span>{attrLabel}</span></nav>
  <h1>{attrLabel}</h1>
  <p class="subtitle">共 {skillList.length} 个技能</p>
  <div class="entity-grid">
    {skillList.map(s => (
      <a href={`${base}/vanilla/skills/${s._sanitizedId}/`} class="entity-item">
        <span class="entity-name">{s.name || s.id}</span>
        <span class="entity-meta">
          {s.levels && s.levels.length > 0 ? `最高 ${s.max_level} 级` : '单级被动'}
          {s.description ? ` · ${s.description.replace(/\[[A-F0-9]{6}\]|\[\-\]/g, '').slice(0, 40)}${s.description.length > 40 ? '…' : ''}` : ''}
        </span>
      </a>
    ))}
  </div>

</Layout>
