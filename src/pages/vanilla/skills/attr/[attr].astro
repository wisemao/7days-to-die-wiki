---
import Layout from '../../../../layouts/Layout.astro';
import { loadData, ATTR_LABELS } from '../../../../utils/data-loader';
const base = '/7days-to-die-wiki';

const ATTR_MAP = { strength: 'strength', fortitude: 'fortitude', perception: 'perception', agility: 'agility', intellect: 'intellect', general: 'generalperks' };

export function getStaticPaths() {
  const MAP = { strength: 'strength', fortitude: 'fortitude', perception: 'perception', agility: 'agility', intellect: 'intellect' };
  const { skills } = loadData();
  const groups = {};
  for (const s of skills) {
    const slug = Object.entries(MAP).find(([,v]) => v === s.category)?.[0] || 'general';
    if (!groups[slug]) groups[slug] = [];
    groups[slug].push(s);
  }
  return Object.entries(groups).map(([slug, list]) => ({
    params: { attr: slug },
    props: { skillList: list.sort((a, b) => (a.name||a.id).localeCompare(b.name||b.id, 'zh')), attrSlug: slug },
  }));
}
const { skillList, attrSlug } = Astro.props;
const attrKey = ATTR_MAP[attrSlug];
const attrLabel = ATTR_LABELS[attrKey] || attrSlug;
---

<Layout title={attrLabel} description={`${attrLabel} - ${skillList.length} 个技能`}>
  <nav class="breadcrumb"><a href={base}>首页</a><span class="sep">/</span><a href={`${base}/vanilla/skills/`}>技能列表</a><span class="sep">/</span><span>{attrLabel}</span></nav>
  <h1>{attrLabel}</h1>
  <p class="subtitle">共 {skillList.length} 个技能</p>
  <div class="item-grid">
    {skillList.map(s => (<a href={`${base}/vanilla/skills/${s._sanitizedId}/`}>{s.name || s.id}</a>))}
  </div>
</Layout>
