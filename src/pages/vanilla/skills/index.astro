---
import Layout from '../../../layouts/Layout.astro';
import { loadData, ATTR_LABELS, SLUG_TO_ATTR_LABEL } from '../../../utils/data-loader';
import { attrIconUrl } from '../../../utils/item-icons';
const { skills } = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function findAttrSlug(key) {
  for (const [slug, label] of Object.entries(SLUG_TO_ATTR_LABEL)) {
    if (label === (ATTR_LABELS[key] || key)) return slug;
  }
  return 'general';
}
function findAttrLabel(slug) {
  return SLUG_TO_ATTR_LABEL[slug] || slug;
}
const cats = {};
for (const s of skills) {
  const slug = findAttrSlug(s.category);
  if (!cats[slug]) cats[slug] = { slug, label: findAttrLabel(slug), count: 0 };
  cats[slug].count++;
}
const order = ['strength', 'fortitude', 'perception', 'agility', 'intellect', 'general'];
const catList = order.filter(s => cats[s]).map(s => cats[s]);
---

<Layout title="技能列表" description={`${skills.length} 个技能`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><span>技能列表</span>
  </nav>
  <h1>技能列表</h1>
  <p class="subtitle">共 {skills.length} 个技能 · 选择属性浏览</p>
  <div class="card-grid">
    {catList.map(c => (
      <a href={`${base}/vanilla/skills/attr/${c.slug}/`} class="card">
        {attrIconUrl(c.slug, base) && <img class="card-icon" src={attrIconUrl(c.slug, base)} alt="" loading="lazy" />}
        <span class="num">{c.count}</span>
        <span class="lbl">{c.label}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .card-icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
    margin: 0 auto 8px;
    display: block;
    border-radius: 8px;
    background: var(--c-surface-2);
    padding: 4px;
  }
</style>
