---
import Layout from '../../../layouts/Layout.astro';
import { loadData, sanitizeId } from '../../../utils/data-loader';
import { readFileSync } from 'fs';

// Load crafting skills for skill magazine items
let craftingSkills = {};
try {
  craftingSkills = JSON.parse(readFileSync('data/crafting-skills.json', 'utf-8'));
} catch {}

export function getStaticPaths() {
  const data = loadData();
  return data.items.map(item => ({
    params: { id: item._sanitizedId },
    props: { item },
  }));
}

const data = loadData();
const { itemCraftRecipes, itemRecipes, resolveItemName, ITEM_CATEGORY_LABELS } = data;
const { item } = Astro.props;
const magInfo = craftingSkills.magazines?.[item.id];

const base = '/7days-to-die-wiki';
const categoryLabel = ITEM_CATEGORY_LABELS[item.category] || item.category;
const stars = item.tier ? (() => {
  let q = 1;
  if (item.tier <= 200) q = 1; else if (item.tier <= 500) q = 2;
  else if (item.tier <= 1100) q = 3; else if (item.tier <= 2000) q = 4;
  else if (item.tier <= 3000) q = 5; else q = 6;
  return '★'.repeat(q) + '☆'.repeat(6 - q);
})() : null;

const craftRecipes = (itemCraftRecipes.get(item.id) || []).filter(r => r.recipe && r.recipe.length > 0);
const usedIn = (itemRecipes.get(item.id) || []);

const LABELS = {
  damage: '攻击力', durability: '耐久度', block_damage: '方块伤害',
  range: '射程', rounds_per_min: '射速', magazine_size: '弹匣容量',
  reload_speed: '换弹速度', mod_slots: '模组插槽', stamina_cost: '体力消耗',
  attacks_per_min: '攻击速度', harvest_count: '采集数量',
  spread_horizontal: '水平散布', spread_vertical: '垂直散布',
  burst_round_count: '连发数', dismember_chance: '肢解概率',
  damage_falloff: '伤害衰减', exp_gain: '经验加成', penetration: '穿透',
  cold_resistance: '寒冷抗性', buff_chance: '异常概率',
  physical_resist: '物理抗性', elemental_resist: '元素抗性',
  heat_resistance: '炎热抗性', carry_capacity: '负重',
  stamina_regen_rate: '体力恢复', loot_stage: '搜刮阶段',
  noise: '噪音', crouch_speed: '潜行速度',
  lockpick_time: '开锁时间', lockpick_break_chance: '开锁破坏率',
  max_health: '最大生命', max_stamina: '最大体力', run_speed: '移动速度',
  damage_reduction: '伤害减免', fuel_consumption: '油耗',
  mobility: '机动性', water_loss_rate: '脱水率', craft_time: '制作时间',
  jump_strength: '跳跃力',
};
---

<Layout title={item.name} description={`${item.name} - ${categoryLabel}`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a> / <a href={`${base}/vanilla/items/`}>物品列表</a> / <span>{item.name}</span>
  </nav>
  <h1>{item.name}</h1>
  {stars && <p><strong>品质:</strong> {stars}</p>}
  <p><strong>类型:</strong> {categoryLabel}</p>
  <p><strong>堆叠:</strong> {item.stack_size}</p>
  {item.description && <p><strong>描述:</strong> {item.description}</p>}

  {item.stats && Object.keys(item.stats).length > 0 && (
    <>
      <h2>基础属性</h2>
      <table><tr><th>属性</th><th>值</th></tr>
        {Object.entries(item.stats).map(([k, v]) => <tr><td>{LABELS[k] || k}</td><td>{v}</td></tr>)}
      </table>
    </>
  )}

  {craftRecipes.map(cr => (
    <div>
      <h2>制作配方</h2>
      <p>{cr.station} | {cr.craft_time}秒 | 产出 {cr.craft_count}</p>
      <ul>{cr.recipe.filter(m => m.count > 0).map(m => <li><a href={`/7days-to-die-wiki/vanilla/items/${sanitizeId(m.item_id)}/`}>{resolveItemName(m.item_id)}</a> x{m.count}</li>)}</ul>
    </div>
  ))}

  {item.scrappable_into?.length > 0 && (
    <div>
      <h2>分解获得</h2>
      <ul>{item.scrappable_into.map(s => <li><a href={`/7days-to-die-wiki/vanilla/items/${sanitizeId(s.item_id)}/`}>{resolveItemName(s.item_id)}</a> x{s.count}</li>)}</ul>
    </div>
  )}

  {usedIn.length > 0 && (
    <div>
      <h2>用于以下配方</h2>
      <ul>{usedIn.map(r => <li><a href={`/7days-to-die-wiki/vanilla/recipes/${r._sanitizedId || sanitizeId(r.id)}/`}>{r.name}</a></li>)}</ul>
    </div>
  )}

  {magInfo && (
    <div style="margin-top:24px;padding:20px;background:var(--c-brand-light);border:1px solid var(--c-border);border-radius:var(--radius);">
      <h2 style="margin-top:0;font-size:1.1rem;">📖 关联技能</h2>
      <p><strong>{magInfo.name}</strong></p>
      {magInfo.desc && <p style="font-size:14px;color:var(--c-text-2);">{magInfo.desc}</p>}
      {magInfo.reqSkill && (
        <p style="font-size:13px;color:var(--c-text-3);">
          需要 <strong>{magInfo.reqName}</strong> 等级 {magInfo.reqLevel} 才能阅读
        </p>
      )}
      {magInfo.recipes?.length > 0 && (
        <>
          <h3 style="font-size:14px;margin:12px 0 6px;">解锁配方</h3>
          <div class="item-grid" style="margin:0;">
            {magInfo.recipes.map(r => (
              <a href={`/7days-to-die-wiki/vanilla/recipes/${sanitizeId(r.id)}/`}>{r.name}</a>
            ))}
          </div>
        </>
      )}
    </div>
  )}
</Layout>
