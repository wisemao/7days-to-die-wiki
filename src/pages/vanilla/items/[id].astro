---
import Layout from '../../../layouts/Layout.astro';
import { loadData, sanitizeId } from '../../../utils/data-loader';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { itemIconUrl } from '../../../utils/item-icons';

// Load crafting skills for skill magazine items
let craftingSkills = {};
try {
  craftingSkills = JSON.parse(readFileSync('data/crafting-skills.json', 'utf-8'));
} catch (e) {
  console.warn('[items] Failed to load crafting-skills.json:', e.message);
}

export function getStaticPaths() {
  const data = loadData();
  return data.items.map(item => ({
    params: { id: item._sanitizedId },
    props: { item },
  }));
}

const data = loadData();
const { itemCraftRecipes, itemRecipes, resolveItemName, itemMap, ITEM_CATEGORY_LABELS } = data;
const { item } = Astro.props;
const magInfo = craftingSkills.magazines?.[item.id];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categoryLabel = ITEM_CATEGORY_LABELS[item.category] || item.category;
const stars = item.tier ? (() => {
  let q = 1;
  if (item.tier <= 200) q = 1; else if (item.tier <= 500) q = 2;
  else if (item.tier <= 1100) q = 3; else if (item.tier <= 2000) q = 4;
  else if (item.tier <= 3000) q = 5; else q = 6;
  return { q, stars: '★'.repeat(q) + '☆'.repeat(6 - q) };
})() : null;
// Official quality colors from qualityinfo.xml (0-6)
const QUALITY_COLORS = ['#808080', '#9C8867', '#CF7F29', '#A2A41B', '#42C234', '#315DCE', '#A42ACC'];
const QUALITY_NAMES = ['破碎', '垃圾', '普通', '罕见', '稀有', '史诗', '传说'];
const qualityColor = stars ? QUALITY_COLORS[stars.q] : null;
const qualityName = stars ? QUALITY_NAMES[stars.q] : null;

// Check if item icon exists (try direct ID, then fallback to base name without suffixes)
const iconBase = item.icon || item.id;
const iconPath = join(process.cwd(), 'public', 'images', 'items', `${iconBase}.png`);
let hasIcon = existsSync(iconPath);
// Fallback: some icons are stored without Schematic/SkillMagazine suffix
if (!hasIcon) {
  const fallbackId = iconBase.replace(/Schematic$|SkillMagazine$/, '');
  if (fallbackId !== iconBase) {
    const fallbackPath = join(process.cwd(), 'public', 'images', 'items', `${fallbackId}.png`);
    hasIcon = existsSync(fallbackPath);
    if (hasIcon) item.__iconId = fallbackId;
  }
}

const craftRecipes = (itemCraftRecipes.get(item.id) || []).filter(r => r.recipe && r.recipe.length > 0);
const usedIn = (itemRecipes.get(item.id) || []);

const LABELS = {
  damage: '攻击力', durability: '耐久度', block_damage: '方块伤害',
  range: '射程', rounds_per_min: '射速', magazine_size: '弹匣容量',
  reload_speed: '换弹速度', mod_slots: '模组插槽', stamina_cost: '体力消耗',
  attacks_per_min: '攻击速度', harvest_count: '采集数量',
  spread_horizontal: '水平散布', spread_vertical: '垂直散布',
  burst_round_count: '连发数', dismember_chance: '肢解概率',
  damage_falloff: '伤害衰减', exp_gain: '经验加成', penetration: '穿透',
  cold_resistance: '寒冷抗性', buff_chance: '异常概率',
  physical_resist: '物理抗性', elemental_resist: '元素抗性',
  heat_resistance: '炎热抗性', carry_capacity: '负重',
  stamina_regen_rate: '体力恢复', loot_stage: '搜刮阶段',
  noise: '噪音', crouch_speed: '潜行速度',
  lockpick_time: '开锁时间', lockpick_break_chance: '开锁破坏率',
  max_health: '最大生命', max_stamina: '最大体力', run_speed: '移动速度',
  hunger: '饥饿恢复', water: '水分恢复', health: '治疗量',
  stamina: '体力恢复', infection_cure: '感染治愈',
  dysentery_cure: '痢疾治愈', buff_duration: '效果持续',
  max_speed: '最大速度', fuel_per_unit: '油耗',
  damage_reduction: '伤害减免', fuel_consumption: '油耗',
  mobility: '机动性', water_loss_rate: '脱水率', craft_time: '制作时间',
  jump_strength: '跳跃力',
};
// Mod slot tags -> Chinese labels
const MOD_SLOT_LABELS = {
  barrelTipAttachment: '枪口附件', sideAttachment: '侧面附件', scope: '瞄具', trigger: '扳机',
  accuracy: '精准', grips: '握把', stocks: '枪托', barrelAttachment: '枪管', magazine: '弹匣',
  crippling: '致残', velocity: '初速', specialDamageAnimal: '动物特伤', specialDamage: '特伤',
  damage: '伤害', durability: '耐久', damageBleed: '出血', stun: '眩晕', health: '生命',
  shaft: '箭杆', fire: '燃烧', knockback: '击退', fuel: '燃料', thermal: '隔热',
  ammo: '弹药', resistance: '抗性', temperature: '温度', movement: '移动',
  carryweight1: '负重', carryweight2: '负重', carryweight3: '负重', carryweight4: '负重',
  stealth: '潜行', falldamage: '坠落', waterPurifier: '净水', misc: '杂项',
  nightVision: '夜视', dye: '染色', test: '测试', fuelsaver: '省油', light: '照明',
  speed: '速度', seat: '座位', fueltank: '油箱', plow: '铲雪', armor: '护甲',
  storage: '存储', cigar: '雪茄', boostPerception: '感知增益', boostStrength: '力量增益',
  boostFortitude: '强壮增益', boostAgility: '敏捷增益', boostIntellect: '智力增益',
  boostTreasure: '宝箱增益', droneArmor: '无人机护甲', droneStorage: '无人机存储',
  droneMorale: '无人机士气', droneLamp: '无人机照明', droneMedic: '无人机医疗', droneWeapon: '无人机武器',
};
function fmtModSlots(raw) {
  if (!raw) return null;
  return raw.split(',').map(t => MOD_SLOT_LABELS[t.trim()] || t.trim()).join('、');
}
function fmtLabel(k) { return LABELS[k] || k; }
function fmtVal(v) {
  if (typeof v === 'number' && v % 1 !== 0) return v.toFixed(2);
  return v;
}
---

<Layout title={item.name} description={`${item.name} - ${categoryLabel}`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a>
    <span class="sep">/</span>
    <a href={`${base}/vanilla/items/`}>物品列表</a>
    <span class="sep">/</span>
    <a href={`${base}/vanilla/items/category/${item.category}/`}>{categoryLabel}</a>
    {magInfo && <><span class="sep">/</span> <a href={`${base}/vanilla/items/category/book/#技能杂志`}>技能杂志</a></>}
    {item.category === 'book' && /Schematic$/.test(item.id) && <><span class="sep">/</span> <a href={`${base}/vanilla/items/category/book/#设计图`}>设计图</a></>}
    {item.category === 'book' && /^book/.test(item.id) && <><span class="sep">/</span> <a href={`${base}/vanilla/items/category/book/#技能书`}>技能书</a></>}
    <span class="sep">/</span>
    <span>{item.name}</span>
  </nav>

  <div class="item-header">
    {hasIcon && (
      <div class="icon">
        <img src={`${base}/images/items/${item.__iconId || item.id}.png`} alt={item.name} loading="lazy" />
      </div>
    )}
    <div class="meta">
      <h1>{item.name}</h1>
      <div class="tags">
        <span class="tag">{categoryLabel}</span>
        <span class="tag">堆叠: {item.stack_size}</span>
        {stars && <span class="tag" style={`background:${qualityColor}1a;border-color:${qualityColor};color:${qualityColor};`}>品质: {qualityName} <span style={`color:${qualityColor};`}>{stars.stars}</span></span>}
        {item.installable_tags && <span class="tag" style="background:#e8f5e9;border-color:#66bb6a;color:#2e7d32;">可安装: {item.installable_tags}</span>}
        {fmtModSlots(item.modifier_tags) && <span class="tag" style="background:#f3e5f5;border-color:#ab47bc;color:#7b1fa2;">槽位: {fmtModSlots(item.modifier_tags)}</span>}
        {item.trader_available && <span class="tag" style="background:#e3f2fd;border-color:#42a5f5;color:#1565c0;">🏪 商人可购</span>}
      </div>
      {item.unlocked_by && (() => {
        const ub = item.unlocked_by;
        const isPerk = ub.startsWith('perk');
        const target = isPerk
          ? { url: `${base}/vanilla/skills/${sanitizeId(ub)}/`, name: resolveItemName(ub) }
          : data.getItemLink(ub) ? { url: `${base}${data.getItemLink(ub)}`, name: resolveItemName(ub) } : null;
        if (!target) return null;
        return (
          <p style="margin-top:10px;font-size:14px;">
            🔓 <strong>解锁:</strong>{' '}
            <a href={target.url} class="unlock-link">
              {target.name}
            </a>
          </p>
        );
      })()}
      {item.description && (
        <p style="margin-top:12px;line-height:1.8;">
          <strong>描述:</strong>{' '}
          {item.description.replace(/\[[A-F0-9]{6}\]|\[\-\]/g, '').split('\\n').map((line, i) => <span>{i > 0 && <br/>}{line}</span>)}
        </p>
      )}
    </div>
  </div>

  {item.stats && Object.keys(item.stats).length > 0 && (
    <>
      <h2>基础属性</h2>
      <div class="stats-grid">
        {Object.entries(item.stats).map(([k, v]) => (
          <div class="stat-item">
            <span class="stat-label">{fmtLabel(k)}</span>
            <span class="stat-value">{fmtVal(v)}</span>
          </div>
        ))}
      </div>
    </>
  )}

  {craftRecipes.map(cr => (
    <div>
      <h2>制作配方</h2>
      <p style="margin-bottom:12px;color:var(--c-text-2);font-size:14px;">
        <span class="tag" style="background:var(--c-blood-light);border-color:var(--c-blood);color:var(--c-blood);">{cr.station}</span>
        {' '}耗时 {cr.craft_time} 秒 · 产出 {cr.craft_count} 个
      </p>
      <div class="recipe-mats">
        {cr.recipe.filter(m => m.count > 0).map(m => {
          const exists = itemMap.has(m.item_id);
          const icon = itemIconUrl({ id: m.item_id }, base);
          const chip = (
            <>
              {icon && <img class="mat-icon" src={icon} alt="" loading="lazy" />}
              <span class="mat-name">{resolveItemName(m.item_id)}</span>
              <span class="mat-count">×{m.count}</span>
            </>
          );
          return exists ? (
            <a href={`${base}/vanilla/items/${sanitizeId(m.item_id)}/`} class="mat-chip">{chip}</a>
          ) : (
            <span class="mat-chip">{chip}</span>
          );
        })}
      </div>
    </div>
  ))}

  {item.scrappable_into?.length > 0 && (
    <div>
      <h2>分解获得</h2>
      <div class="recipe-mats">
        {item.scrappable_into.map(s => {
          const exists = itemMap.has(s.item_id);
          const icon = itemIconUrl({ id: s.item_id }, base);
          const chip = (
            <>
              {icon && <img class="mat-icon" src={icon} alt="" loading="lazy" />}
              <span class="mat-name">{resolveItemName(s.item_id)}</span>
              <span class="mat-count">×{s.count}</span>
            </>
          );
          return exists ? (
            <a href={`${base}/vanilla/items/${sanitizeId(s.item_id)}/`} class="mat-chip">{chip}</a>
          ) : (
            <span class="mat-chip">{chip}</span>
          );
        })}
      </div>
    </div>
  )}

  {usedIn.length > 0 && (
    <div>
      <h2>用于以下配方</h2>
      <ul>{usedIn.map(r => <li><a href={`${base}/vanilla/recipes/${r._sanitizedId || sanitizeId(r.id)}/`}>{r.name}</a></li>)}</ul>
    </div>
  )}

  {(() => {
    const droppers = data.zombieLoot.get(item.id);
    if (!droppers || droppers.length === 0) return null;
    return (
      <div>
        <h2>掉落来源</h2>
        <div class="item-grid" style="margin:8px 0 16px;">
          {droppers.map(z => (
            <a href={`${base}/vanilla/zombies/${z._sanitizedId}/`} class="grid-item-link">
              <span class="grid-name">🧟 {z.name}</span>
            </a>
          ))}
        </div>
      </div>
    );
  })()}

  {magInfo && (
    <div class="info-card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
        <span style="font-size:24px;">📖</span>
        <h2 style="margin:0;color:var(--c-blood);font-size:1.15rem;">关联技能</h2>
      </div>
      <p><strong>{magInfo.name}</strong></p>
      {magInfo.desc && <p style="font-size:14px;color:var(--c-text-2);">{magInfo.desc.replace(/\[[A-F0-9]{6}\]|\[\-\]/g, '').split('\\n').map((line, i) => <span>{i > 0 && <br/>}{line}</span>)}</p>}
      {magInfo.reqSkill && (
        <p style="font-size:13px;color:var(--c-text-3);">
          需要 <strong>{magInfo.reqName}</strong> 等级 {magInfo.reqLevel} 才能阅读
        </p>
      )}
      {magInfo.recipeTiers?.length > 0 && (
        <>
          <h3 style="font-size:14px;margin:16px 0 8px;">解锁配方（按技能等级）</h3>
          {magInfo.recipeTiers.map(tier => (
            <div style="margin-bottom:10px;">
              <p style="font-size:13px;font-weight:600;color:var(--c-blood);margin:0 0 4px;">
                等级 {tier.level} 解锁
              </p>
              <div class="item-grid" style="margin:0;">
                {tier.recipes.map(r => {
                  const displayName = /^[a-zA-Z0-9_]+$/.test(r.name)
                    ? r.name.replace(/BlockVariantHelper|_Powered|_player/g, '').replace(/([a-z])([A-Z])/g, '$1 $2')
                    : r.name;
                  const hasRecipe = data.recipes.some(rc => rc.id === r.id);
                  return hasRecipe
                    ? <a href={`${base}/vanilla/recipes/${sanitizeId(r.id)}/`}>{displayName}</a>
                    : <span style="opacity:.7;">{displayName}</span>;
                })}
              </div>
            </div>
          ))}
        </>
      )}
    </div>
  )}

  {(() => {
    const related = data.items
      .filter(i => i.category === item.category && i.id !== item.id)
      .sort((a, b) => (a.name || '').localeCompare(b.name || '', 'zh'))
      .slice(0, 12);
    if (related.length === 0) return null;
    return (
      <div>
        <h2>同类物品</h2>
        <div class="item-grid" style="margin:8px 0 16px;">
          {related.map(i => {
            const icon = itemIconUrl(i, base);
            return (
              <a href={`${base}/vanilla/items/${i._sanitizedId}/`} class="grid-item-link">
                {icon && <img class="grid-icon" src={icon} alt="" loading="lazy" />}
                <span class="grid-name">{i.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    );
  })()}

  <style>
    /* ─── Stats Grid ─── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 8px;
      margin: 16px 0;
    }
    .stat-item {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      display: flex;
      flex-direction: column;
      transition: border-color 0.15s;
    }
    .stat-item:hover { border-color: var(--c-rust-light); }
    .stat-label { font-size: 12px; color: var(--c-text-3); text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-value { font-size: 16px; font-weight: 700; color: var(--c-text); margin-top: 2px; }

    /* ─── Recipe Materials ─── */
    .recipe-mats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 8px 0 16px;
    }
    .mat-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      transition: all 0.15s;
      text-decoration: none !important;
    }
    .mat-chip:hover {
      border-color: var(--c-blood);
      background: var(--c-blood-light);
      transform: translateY(-1px);
    }
    .mat-name { color: var(--c-text); }
    .mat-icon {
      width: 22px;
      height: 22px;
      object-fit: contain;
      flex-shrink: 0;
    }
    .mat-count {
      font-weight: 700;
      color: var(--c-blood);
      font-size: 13px;
    }
  </style>
</Layout>
