---
import Layout from '../../../layouts/Layout.astro';
import { loadData, ITEM_CATEGORY_LABELS } from '../../../utils/data-loader';
import { categoryIconUrl } from '../../../utils/item-icons';
const { items } = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const catCounts: Record<string, { key: string; label: string; count: number; icon: string | null }> = {};
for (const item of items) {
  const label = ITEM_CATEGORY_LABELS[item.category] || item.category;
  if (!catCounts[item.category]) catCounts[item.category] = { key: item.category, label, count: 0, icon: categoryIconUrl(item.category, base) };
  catCounts[item.category].count++;
}
const cats = Object.values(catCounts).sort((a, b) => b.count - a.count);
---

<Layout title="物品列表" description={`${items.length} 个物品`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><span>物品列表</span>
  </nav>
  <h1>物品列表</h1>
  <p class="subtitle">共 {items.length} 个物品 · 选择分类浏览</p>
  <div class="card-grid">
    {cats.map(c => (
      <a href={`${base}/vanilla/items/category/${c.key}/`} class="card">
        {c.icon && <img class="card-icon" src={c.icon} alt="" loading="lazy" />}
        <span class="num">{c.count}</span>
        <span class="lbl">{c.label}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .card-icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
    margin: 0 auto 8px;
    display: block;
    border-radius: 8px;
    background: var(--c-surface-2);
    padding: 4px;
  }
</style>
