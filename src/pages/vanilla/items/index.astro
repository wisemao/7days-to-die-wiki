---
import Layout from '../../../layouts/Layout.astro';
import { loadData, ITEM_CATEGORY_LABELS } from '../../../utils/data-loader';
const { items } = loadData();
const base = '/7days-to-die-wiki';

const catCounts = {};
for (const item of items) {
  const label = ITEM_CATEGORY_LABELS[item.category] || item.category;
  if (!catCounts[item.category]) catCounts[item.category] = { key: item.category, label, count: 0 };
  catCounts[item.category].count++;
}
const cats = Object.values(catCounts).sort((a, b) => b.count - a.count);
---

<Layout title="物品列表" description={`${items.length} 个物品`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span><span>物品列表</span>
  </nav>
  <h1>物品列表</h1>
  <p class="subtitle">共 {items.length} 个物品 · 选择分类浏览</p>
  <div class="card-grid">
    {cats.map(c => (
      <a href={`${base}/vanilla/items/category/${c.key}/`} class="card">
        <span class="num">{c.count}</span>
        <span class="lbl">{c.label}</span>
      </a>
    ))}
  </div>
</Layout>
