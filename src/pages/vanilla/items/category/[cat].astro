---
import Layout from '../../../../layouts/Layout.astro';
import ItemGridLink from '../../../../components/ItemGridLink.astro';
import { loadData, ITEM_CATEGORY_LABELS } from '../../../../utils/data-loader';
import { itemIconUrl, categoryIconUrl } from '../../../../utils/item-icons';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Astro note: module-level function declarations are NOT accessible in component scope.
// Use const arrow functions for helpers needed in both frontmatter and template.
const toSlug = (name) => name.replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fff-]/g, '');
const extractSeries = (chn) => chn.replace(/[ 　]*第\s*\d+\s*[卷册][\s\S]*$/, '').replace(/[ 　]*卷\s*\d+[\s\S]*$/, '').trim();

export function getStaticPaths() {
  const { items } = loadData();
  const cats = {};
  for (const item of items) {
    if (!cats[item.category]) cats[item.category] = [];
    cats[item.category].push(item);
  }
  return Object.entries(cats).map(([key, list]) => ({
    params: { cat: key },
    props: { catItems: list.sort((a, b) => a.name.localeCompare(b.name, 'zh')), catKey: key },
  }));
}
const { catItems, catKey } = Astro.props;
const catLabel = ITEM_CATEGORY_LABELS[catKey] || catKey;

// For book category: group schematics by type, skill books by series
const schematicSub = catKey === 'book' ? (() => {
  const sgs = { '武器': [], '护甲': [], '载具': [], '工具': [], '机器人': [], '其他': [] };
  for (const i of catItems) {
    if (!/Schematic$/.test(i.id)) continue;
    const id = i.id;
    if (/^modGun|^modShotgun|^modMelee/.test(id) || /Gun|Melee|Bow|Shotgun/.test(id)) sgs['武器'].push(i);
    else if (/^modArmor/.test(id)) sgs['护甲'].push(i);
    else if (/^modVehicle/.test(id)) sgs['载具'].push(i);
    else if (/^modFuelTank/.test(id)) sgs['工具'].push(i);
    else if (/^modRobotic/.test(id)) sgs['机器人'].push(i);
    else sgs['其他'].push(i);
  }
  return Object.entries(sgs).filter(([,v]) => v.length > 0);
})() : null;

// For book category: group skill books by series
const bookSeries = catKey === 'book' ? (() => {
  const series = {};
  for (const b of catItems) {
    if (!/^book/.test(b.id) && !/^questReward/.test(b.id)) continue;
    const sn = extractSeries(b.name || b.id);
    if (!series[sn]) series[sn] = [];
    series[sn].push(b);
  }
  return Object.entries(series).sort((a, b) => b[1].length - a[1].length);
})() : null;

const schematicCount = schematicSub ? schematicSub.reduce((s, [,v]) => s + v.length, 0) : 0;
const bookSeriesCount = bookSeries ? bookSeries.reduce((s, [,v]) => s + v.length, 0) : 0;

// ─── Armor: group by set (armor<Set><Slot>) instead of body slot ───
const armorGrouped = catKey === 'armor' ? (() => {
  const SLOT_ORDER = ['Helmet', 'Outfit', 'Gloves', 'Boots'];
  const stripSlot = (n) => (n || '').replace(/(帽子|兜帽|头盔|装束|套装|装|手套|靴子|鞋子)$/, '');
  // Single-slot special headwear sets (masks, holiday hats, brand hats)
  const SPECIAL_CODES = /^(Monster|Vampire|Werewolf|Zombie|Inspector|NobleThief|PennyPincher|TheHatter|Santa|Elf|Reindeer|Snowman|Tree|PimpHat)/;
  const sets = new Map();
  const masks = [], baseClothing = [], misc = [];
  for (const item of catItems) {
    const m = item.id.match(/^armor([A-Z][a-zA-Z]*)(Helmet|Outfit|Gloves|Boots)$/);
    if (!m) {
      if (/^clothing/.test(item.id)) baseClothing.push(item);
      else misc.push(item);
      continue;
    }
    const [, code, slot] = m;
    if (SPECIAL_CODES.test(code)) { masks.push(item); continue; }
    if (!sets.has(code)) sets.set(code, { name: '', items: [] });
    sets.get(code).items.push(item);
  }
  // Derive set name from the Outfit piece first (cleanest), fallback to Helmet
  for (const [, s] of sets) {
    s.items.sort((a, b) => {
      const sa = a.id.match(/(Helmet|Outfit|Gloves|Boots)$/)[1];
      const sb = b.id.match(/(Helmet|Outfit|Gloves|Boots)$/)[1];
      return SLOT_ORDER.indexOf(sa) - SLOT_ORDER.indexOf(sb);
    });
    const outfit = s.items.find(i => /Outfit$/.test(i.id));
    const helmet = s.items.find(i => /Helmet$/.test(i.id));
    const src = outfit || helmet || s.items[0];
    s.name = stripSlot(src.name);
  }
  // Split: full sets (>=3 pieces) vs brand uniforms (2 pieces: Helmet+Outfit)
  const setGroups = [], brandGroups = [];
  for (const [code, s] of [...sets.entries()].sort((a, b) => a[1].name.localeCompare(b[1].name, 'zh'))) {
    if (s.items.length >= 3) setGroups.push([code, s]);
    else brandGroups.push([code, s]);
  }
  const setCount = setGroups.reduce((s, [, v]) => s + v.items.length, 0);
  const brandCount = brandGroups.reduce((s, [, v]) => s + v.items.length, 0);
  return { setGroups, brandGroups, masks, baseClothing, misc, setCount, brandCount };
})() : null;

// ─── Sub-grouping for non-book categories ───
// melee_weapon/ranged_weapon: by weapon type; material: by resource type
// food: by preparation; medical: by type
const subGroups = catKey === 'melee_weapon' || catKey === 'ranged_weapon' || catKey === 'material' || catKey === 'food' || catKey === 'medical' || catKey === 'ammo' || catKey === 'vehicle' || catKey === 'tool' || catKey === 'quest_item' || catKey === 'mod' ? (() => {
  const defs = {
    melee_weapon: [
      ['刀剑', /Blade|Knife|Machete/],
      ['棍棒', /Club|Baton/],
      ['长矛', /Spear/],
      ['大锤', /Sledge/],
      ['拳套', /Knuckles/],
      ['其他', null],
    ],
    ranged_weapon: [
      ['手枪', /Handgun|Pistol|Magnum|Revolver/],
      ['霰弹枪', /Shotgun|Boomstick/],
      ['步枪/机枪', /Rifle|Sniper|AK47|M60|MachineGun|MG/],
      ['弓弩', /Bow|Crossbow/],
      ['机器人', /JunkTurret|Robotic|Bot/],
      ['爆炸物', /Rocket|Explosive|Launcher/],
      ['其他', null],
    ],
    material: [
      ['基础资源', /^resource/],
      ['武器/工具零件', /Parts$/],
      ['载具/机械部件', /^bucket|^smallEngine|^carBattery|^solarCell/],
      ['其他', null],
    ],
    food: [
      ['罐头食品', /^foodCan/],
      ['农作物/原料', /^foodCrop/],
      ['烹饪食品', /^food/],
      ['饮品', /^drink/],
      ['其他', null],
    ],
    medical: [
      ['治疗用品', /^medical/],
      ['药品', /^drug/],
      ['其他', null],
    ],
    ammo: [
      ['子弹', /^ammo(9mm|44|762|Shotgun)/],
      ['箭矢', /^ammoArrow/],
      ['弩箭', /^ammoCrossbowBolt/],
      ['投掷物/爆炸物', /^thrown|^ammoRocket|^ammoGasCan|^ammoDart/],
      ['炮塔弹药', /^ammoJunkTurret/],
      ['弹药盒', /^ammoBundle/],
      ['其他', null],
    ],
    vehicle: [
      ['自行车', /^vehicleBicycle/],
      ['小型机车', /^vehicleMinibike/],
      ['摩托车', /^vehicleMotorcycle/],
      ['4x4 卡车', /^vehicleTruck/],
      ['旋翼机', /^vehicleGyro/],
      ['其他', null],
    ],
    tool: [
      ['电动工具', /^meleeTool(AxeT3|PickT3|RepairT3)/],
      ['伐木/采矿工具', /^meleeTool(Axe|Pick|Shovel)/],
      ['修理工具', /^meleeToolRepair/],
      ['拆解工具', /^meleeToolSalvage/],
      ['生活工具', /^meleeTool(Flashlight|Torch|WireTool|PaintTool)/],
      ['生产设备', /^tool(Cooking|Beaker|Bellows|Anvil|Forge)/],
      ['养殖/采集设备', /^tool(Dew|Apiary|ChickenCoop)/],
      ['其他', null],
    ],
    quest_item: [
      ['藏宝图', /^qt_/],
      ['任务奖励', /^questReward/],
      ['徽章/特殊', /^biomeBadge|^note|^questItem/],
      ['其他', null],
    ],
    mod: [
      ['武器模组', /^modGun|^modMelee|^modShotgun/],
      ['护甲模组', /^modArmor/],
      ['载具模组', /^modVehicle|^modFuelTank/],
      ['无人机模组', /^modRobotic/],
      ['其他', null],
    ],
  };
  const def = defs[catKey];
  const groups = def.map(([label]) => [label, []]);
  for (const item of catItems) {
    let placed = false;
    for (const [label, re] of def) {
      if (re && re.test(item.id)) {
        groups.find(g => g[0] === label)[1].push(item);
        placed = true;
        break;
      }
    }
    if (!placed) groups.find(g => g[0] === '其他')[1].push(item);
  }
  return groups.filter(([, v]) => v.length > 0);
})() : null;
const subGroupCount = subGroups ? subGroups.reduce((s, [,v]) => s + v.length, 0) : 0;
---

<Layout title={catLabel} description={`${catLabel} - ${catItems.length} 个物品`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span>
    <a href={`${base}/vanilla/items/`}>物品列表</a><span class="sep">/</span>
    <span>{catLabel}</span>
  </nav>
  <div class="cat-header">
    {categoryIconUrl(catKey, base) && (
      <img class="cat-hero-icon" src={categoryIconUrl(catKey, base)} alt={catLabel} loading="lazy" />
    )}
    <div>
      <h1 style="margin:0;">{catLabel}</h1>
      <p class="subtitle" style="margin:4px 0 0;">共 {catItems.length} 个物品</p>
    </div>
  </div>

  {catKey === 'book' ? (
    <div class="book-layout">
      {schematicSub && (
        <section id="设计图" class="book-section">
          <h2 class="collapsible section-head">
            <span class="section-icon">🔧</span>
            <span>设计图</span>
            <span class="section-count">{schematicCount} 项</span>
          </h2>
          <div>
            <div class="card-grid">
              {schematicSub.map(([g, list]) => (
                <a href={`#${g}`} class="card">
                  <span class="num">{list.length}</span>
                  <span class="lbl">{g}</span>
                </a>
              ))}
            </div>
            {schematicSub.map(([g, list]) => (
              <section id={g} class="sub-section">
                <h3 class="collapsible collapsed sub-head">
                  <span>{g}</span>
                </h3>
                <div class="item-grid">{list.map(item => <ItemGridLink item={item} base={base} />)}</div>
              </section>
            ))}
          </div>
        </section>
      )}

      {(() => {
        const mags = catItems.filter(i => /SkillMagazine$/.test(i.id));
        if (mags.length === 0) return null;
        return (
          <section id="技能杂志" class="book-section">
            <h2 class="collapsible section-head">
              <span class="section-icon">📘</span>
              <span>技能杂志</span>
              <span class="section-count">{mags.length} 项</span>
            </h2>
            <div class="item-grid">{mags.map(item => <ItemGridLink item={item} base={base} />)}</div>
          </section>
        );
      })()}

      {bookSeries && (
        <section id="技能书" class="book-section">
          <h2 class="collapsible section-head">
            <span class="section-icon">📚</span>
            <span>技能书系列</span>
            <span class="section-count">{bookSeriesCount} 卷</span>
          </h2>
          <div class="card-grid">
            {bookSeries
              .filter(([, list]) => list.length > 1)
              .map(([name, list]) => {
                const seriesIcon = itemIconUrl(list[0], base);
                return (
                  <a href={`${base}/vanilla/book-series/${toSlug(name)}/`} class="card">
                    {seriesIcon && <img class="card-icon" src={seriesIcon} alt="" loading="lazy" />}
                    <span class="num">{list.length}</span>
                    <span class="lbl">{name}</span>
                  </a>
                );
              })}
          </div>
          {(() => {
            const singles = bookSeries.filter(([, list]) => list.length === 1).flatMap(([, list]) => list);
            if (singles.length === 0) return null;
            return (
              <div class="item-grid" style="margin-top:8px;">
                {singles.map(item => <ItemGridLink item={item} base={base} />)}
              </div>
            );
          })()}
        </section>
      )}
    </div>
  ) : armorGrouped ? (
    <div class="book-layout">
      <div class="card-grid">
        <a href="#护甲套装" class="card">
          <span class="num">{armorGrouped.setGroups.length}</span>
          <span class="lbl">护甲套装（{armorGrouped.setCount} 件）</span>
        </a>
        {armorGrouped.brandGroups.length > 0 && (
          <a href="#品牌制服" class="card">
            <span class="num">{armorGrouped.brandGroups.length}</span>
            <span class="lbl">品牌制服（{armorGrouped.brandCount} 件）</span>
          </a>
        )}
        <a href="#面具与特殊头饰" class="card">
          <span class="num">{armorGrouped.masks.length}</span>
          <span class="lbl">面具与特殊头饰</span>
        </a>
        <a href="#基础衣物" class="card">
          <span class="num">{armorGrouped.baseClothing.length}</span>
          <span class="lbl">基础衣物</span>
        </a>
        <a href="#其他" class="card">
          <span class="num">{armorGrouped.misc.length}</span>
          <span class="lbl">其他</span>
        </a>
      </div>

      <section id="护甲套装" class="book-section" style="scroll-margin-top:72px;">
        <h2 class="collapsible section-head">
          <span class="section-icon">🛡️</span>
          <span>护甲套装</span>
          <span class="section-count">{armorGrouped.setGroups.length} 套 · {armorGrouped.setCount} 件</span>
        </h2>
        {armorGrouped.setGroups.map(([code, s]) => (
          <section id={toSlug(code)} class="sub-section">
            <h3 class="collapsible collapsed sub-head">
              <span>{s.name}</span>
              <span class="section-count">{s.items.length} 件</span>
            </h3>
            <div class="item-grid">{s.items.map(item => <ItemGridLink item={item} base={base} />)}</div>
          </section>
        ))}
      </section>

      {armorGrouped.brandGroups.length > 0 && (
        <section id="品牌制服" class="book-section" style="scroll-margin-top:72px;">
          <h2 class="collapsible section-head">
            <span class="section-icon">🏷️</span>
            <span>品牌制服</span>
            <span class="section-count">{armorGrouped.brandGroups.length} 套 · {armorGrouped.brandCount} 件</span>
          </h2>
          {armorGrouped.brandGroups.map(([code, s]) => (
            <section id={toSlug(code)} class="sub-section">
              <h3 class="collapsible collapsed sub-head">
                <span>{s.name}</span>
                <span class="section-count">{s.items.length} 件</span>
              </h3>
              <div class="item-grid">{s.items.map(item => <ItemGridLink item={item} base={base} />)}</div>
            </section>
          ))}
        </section>
      )}

      <section id="面具与特殊头饰" class="book-section" style="scroll-margin-top:72px;">
        <h2 class="collapsible section-head">
          <span class="section-icon">🎭</span>
          <span>面具与特殊头饰</span>
          <span class="section-count">{armorGrouped.masks.length} 项</span>
        </h2>
        <div class="item-grid">{armorGrouped.masks.map(item => <ItemGridLink item={item} base={base} />)}</div>
      </section>

      <section id="基础衣物" class="book-section" style="scroll-margin-top:72px;">
        <h2 class="collapsible section-head">
          <span class="section-icon">👕</span>
          <span>基础衣物</span>
          <span class="section-count">{armorGrouped.baseClothing.length} 项</span>
        </h2>
        <div class="item-grid">{armorGrouped.baseClothing.map(item => <ItemGridLink item={item} base={base} />)}</div>
      </section>

      <section id="其他" class="book-section" style="scroll-margin-top:72px;">
        <h2 class="collapsible section-head">
          <span class="section-icon">📦</span>
          <span>其他</span>
          <span class="section-count">{armorGrouped.misc.length} 项</span>
        </h2>
        <div class="item-grid">{armorGrouped.misc.map(item => <ItemGridLink item={item} base={base} />)}</div>
      </section>
    </div>
  ) : subGroups ? (
    <div class="book-layout">
      <div class="card-grid">
        {subGroups.map(([label, list]) => (
          <a href={`#${toSlug(label)}`} class="card">
            <span class="num">{list.length}</span>
            <span class="lbl">{label}</span>
          </a>
        ))}
      </div>
      {subGroups.map(([label, list]) => (
        <section id={toSlug(label)} class="book-section sub-section" style="scroll-margin-top:72px;">
          <h2 class="collapsible section-head">
            <span>{label}</span>
            <span class="section-count">{list.length} 项</span>
          </h2>
          <div class="item-grid">{list.map(item => <ItemGridLink item={item} base={base} />)}</div>
        </section>
      ))}
    </div>
  ) : (
    <div class="item-grid">
      {catItems.map(item => <ItemGridLink item={item} base={base} />)}
    </div>
  )}

  <style>
    .cat-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 8px;
    }
    .cat-hero-icon {
      width: 64px;
      height: 64px;
      object-fit: contain;
      image-rendering: auto;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 6px;
      flex-shrink: 0;
    }
    /* Item links with icons: hide the decorative dot, show icon instead */
    .item-grid a::before { display: none; }
    .book-layout {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .book-section {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 16px 20px;
    }
    .section-head {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 4px;
      padding-bottom: 8px;
      border-bottom: none !important;
      font-size: 1.1rem;
    }
    .section-icon { font-size: 18px; flex-shrink: 0; }
    .section-count {
      margin-left: auto;
      font-size: 13px;
      font-weight: 400;
      color: var(--c-text-3);
    }
    .sub-section {
      scroll-margin-top: 72px;
      margin-bottom: 8px;
    }
    .sub-section:last-child { margin-bottom: 0; }
    .sub-section .item-grid { margin: 4px 0 0; }
    .sub-head {
      font-size: 14px;
      font-weight: 600;
      margin: 8px 0 4px;
      color: var(--c-text-2);
    }
  </style>
</Layout>
