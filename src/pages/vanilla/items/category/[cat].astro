---
import Layout from '../../../../layouts/Layout.astro';
import { loadData, ITEM_CATEGORY_LABELS } from '../../../../utils/data-loader';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Astro note: module-level function declarations are NOT accessible in component scope.
// Use const arrow functions for helpers needed in both frontmatter and template.
const toSlug = (name) => name.replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fff-]/g, '');
const extractSeries = (chn) => chn.replace(/[ 　]*第\s*\d+\s*[卷册][\s\S]*$/, '').replace(/[ 　]*卷\s*\d+[\s\S]*$/, '').trim();

export function getStaticPaths() {
  const { items } = loadData();
  const cats = {};
  for (const item of items) {
    if (!cats[item.category]) cats[item.category] = [];
    cats[item.category].push(item);
  }
  return Object.entries(cats).map(([key, list]) => ({
    params: { cat: key },
    props: { catItems: list.sort((a, b) => a.name.localeCompare(b.name, 'zh')), catKey: key },
  }));
}
const { catItems, catKey } = Astro.props;
const catLabel = ITEM_CATEGORY_LABELS[catKey] || catKey;

// For book category: group schematics by type, skill books by series
const schematicSub = catKey === 'book' ? (() => {
  const sgs = { '武器': [], '护甲': [], '载具': [], '工具': [], '机器人': [], '其他': [] };
  for (const i of catItems) {
    if (!/Schematic$/.test(i.id)) continue;
    const id = i.id;
    if (/^modGun|^modShotgun|^modMelee/.test(id) || /Gun|Melee|Bow|Shotgun/.test(id)) sgs['武器'].push(i);
    else if (/^modArmor/.test(id)) sgs['护甲'].push(i);
    else if (/^modVehicle/.test(id)) sgs['载具'].push(i);
    else if (/^modFuelTank/.test(id)) sgs['工具'].push(i);
    else if (/^modRobotic/.test(id)) sgs['机器人'].push(i);
    else sgs['其他'].push(i);
  }
  return Object.entries(sgs).filter(([,v]) => v.length > 0);
})() : null;

// For book category: group skill books by series
const bookSeries = catKey === 'book' ? (() => {
  const series = {};
  for (const b of catItems) {
    if (!/^book/.test(b.id) && !/^questReward/.test(b.id)) continue;
    const sn = extractSeries(b.name || b.id);
    if (!series[sn]) series[sn] = [];
    series[sn].push(b);
  }
  return Object.entries(series).sort((a, b) => b[1].length - a[1].length);
})() : null;

const schematicCount = schematicSub ? schematicSub.reduce((s, [,v]) => s + v.length, 0) : 0;
const bookSeriesCount = bookSeries ? bookSeries.reduce((s, [,v]) => s + v.length, 0) : 0;

// ─── Sub-grouping for non-book categories ───
// armor: by equipment slot; melee_weapon/ranged_weapon: by weapon type
// material: by resource type; food: by preparation; medical: by type
const subGroups = catKey === 'armor' || catKey === 'melee_weapon' || catKey === 'ranged_weapon' || catKey === 'material' || catKey === 'food' || catKey === 'medical' || catKey === 'ammo' || catKey === 'vehicle' || catKey === 'tool' || catKey === 'quest_item' ? (() => {
  const defs = {
    armor: [
      ['头盔/帽子', /Helmet|Hat$|Head/],
      ['服装', /Outfit|Shirt|Coat|Jacket|Suit|Cloth/i],
      ['手套', /Gloves|Hands/],
      ['靴子/鞋子', /Boots|Feet|Shoes/],
      ['其他', null],
    ],
    melee_weapon: [
      ['刀剑', /Blade|Knife|Machete/],
      ['棍棒', /Club|Baton/],
      ['长矛', /Spear/],
      ['大锤', /Sledge/],
      ['拳套', /Knuckles/],
      ['其他', null],
    ],
    ranged_weapon: [
      ['手枪', /Handgun|Pistol|Magnum|Revolver/],
      ['霰弹枪', /Shotgun|Boomstick/],
      ['步枪/机枪', /Rifle|Sniper|AK47|M60|MachineGun|MG/],
      ['弓弩', /Bow|Crossbow/],
      ['机器人', /JunkTurret|Robotic|Bot/],
      ['爆炸物', /Rocket|Explosive|Launcher/],
      ['其他', null],
    ],
    material: [
      ['基础资源', /^resource/],
      ['武器/工具零件', /Parts$/],
      ['载具/机械部件', /^bucket|^smallEngine|^carBattery|^solarCell/],
      ['其他', null],
    ],
    food: [
      ['罐头食品', /^foodCan/],
      ['农作物/原料', /^foodCrop/],
      ['烹饪食品', /^food/],
      ['饮品', /^drink/],
      ['其他', null],
    ],
    medical: [
      ['治疗用品', /^medical/],
      ['药品', /^drug/],
      ['其他', null],
    ],
    ammo: [
      ['子弹', /^ammo(9mm|44|762|Shotgun)/],
      ['箭矢', /^ammoArrow/],
      ['弩箭', /^ammoCrossbowBolt/],
      ['投掷物/爆炸物', /^thrown|^ammoRocket|^ammoGasCan|^ammoDart/],
      ['炮塔弹药', /^ammoJunkTurret/],
      ['弹药盒', /^ammoBundle/],
      ['其他', null],
    ],
    vehicle: [
      ['自行车', /^vehicleBicycle/],
      ['小型机车', /^vehicleMinibike/],
      ['摩托车', /^vehicleMotorcycle/],
      ['4x4 卡车', /^vehicleTruck/],
      ['旋翼机', /^vehicleGyro/],
      ['其他', null],
    ],
    tool: [
      ['电动工具', /^meleeTool(AxeT3|PickT3|RepairT3)/],
      ['伐木/采矿工具', /^meleeTool(Axe|Pick|Shovel)/],
      ['修理工具', /^meleeToolRepair/],
      ['拆解工具', /^meleeToolSalvage/],
      ['生活工具', /^meleeTool(Flashlight|Torch|WireTool|PaintTool)/],
      ['生产设备', /^tool(Cooking|Beaker|Bellows|Anvil|Forge)/],
      ['养殖/采集设备', /^tool(Dew|Apiary|ChickenCoop)/],
      ['其他', null],
    ],
    quest_item: [
      ['藏宝图', /^qt_/],
      ['任务奖励', /^questReward/],
      ['徽章/特殊', /^biomeBadge|^note|^questItem/],
      ['其他', null],
    ],
  };
  const def = defs[catKey];
  const groups = def.map(([label]) => [label, []]);
  for (const item of catItems) {
    let placed = false;
    for (const [label, re] of def) {
      if (re && re.test(item.id)) {
        groups.find(g => g[0] === label)[1].push(item);
        placed = true;
        break;
      }
    }
    if (!placed) groups.find(g => g[0] === '其他')[1].push(item);
  }
  return groups.filter(([, v]) => v.length > 0);
})() : null;
const subGroupCount = subGroups ? subGroups.reduce((s, [,v]) => s + v.length, 0) : 0;
---

<Layout title={catLabel} description={`${catLabel} - ${catItems.length} 个物品`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span>
    <a href={`${base}/vanilla/items/`}>物品列表</a><span class="sep">/</span>
    <span>{catLabel}</span>
  </nav>
  <h1>{catLabel}</h1>
  <p class="subtitle">共 {catItems.length} 个物品</p>

  {catKey === 'book' ? (
    <div class="book-layout">
      {schematicSub && (
        <section id="设计图" class="book-section">
          <h2 class="collapsible section-head">
            <span class="section-icon">🔧</span>
            <span>设计图</span>
            <span class="section-count">{schematicCount} 项</span>
          </h2>
          <div>
            <div class="card-grid">
              {schematicSub.map(([g, list]) => (
                <a href={`#${g}`} class="card">
                  <span class="num">{list.length}</span>
                  <span class="lbl">{g}</span>
                </a>
              ))}
            </div>
            {schematicSub.map(([g, list]) => (
              <section id={g} class="sub-section">
                <h3 class="collapsible collapsed sub-head">
                  <span>{g}</span>
                </h3>
                <div class="item-grid">{list.map(item => (<a href={`${base}/vanilla/items/${item._sanitizedId}/`}>{item.name}</a>))}</div>
              </section>
            ))}
          </div>
        </section>
      )}

      {(() => {
        const mags = catItems.filter(i => /SkillMagazine$/.test(i.id));
        if (mags.length === 0) return null;
        return (
          <section id="技能杂志" class="book-section">
            <h2 class="collapsible section-head">
              <span class="section-icon">📘</span>
              <span>技能杂志</span>
              <span class="section-count">{mags.length} 项</span>
            </h2>
            <div class="item-grid">{mags.map(item => (<a href={`${base}/vanilla/items/${item._sanitizedId}/`}>{item.name}</a>))}</div>
          </section>
        );
      })()}

      {bookSeries && (
        <section id="技能书" class="book-section">
          <h2 class="collapsible section-head">
            <span class="section-icon">📚</span>
            <span>技能书系列</span>
            <span class="section-count">{bookSeriesCount} 卷</span>
          </h2>
          <div class="card-grid">
            {bookSeries
              .filter(([, list]) => list.length > 1)
              .map(([name, list]) => (
                <a href={`${base}/vanilla/book-series/${toSlug(name)}/`} class="card">
                  <span class="num">{list.length}</span>
                  <span class="lbl">{name}</span>
                </a>
              ))}
          </div>
          {(() => {
            const singles = bookSeries.filter(([, list]) => list.length === 1).flatMap(([, list]) => list);
            if (singles.length === 0) return null;
            return (
              <div class="item-grid" style="margin-top:8px;">
                {singles.map(item => (<a href={`${base}/vanilla/items/${item._sanitizedId}/`}>{item.name}</a>))}
              </div>
            );
          })()}
        </section>
      )}
    </div>
  ) : subGroups ? (
    <div class="book-layout">
      <div class="card-grid">
        {subGroups.map(([label, list]) => (
          <a href={`#${toSlug(label)}`} class="card">
            <span class="num">{list.length}</span>
            <span class="lbl">{label}</span>
          </a>
        ))}
      </div>
      {subGroups.map(([label, list]) => (
        <section id={toSlug(label)} class="book-section sub-section" style="scroll-margin-top:72px;">
          <h2 class="collapsible section-head">
            <span>{label}</span>
            <span class="section-count">{list.length} 项</span>
          </h2>
          <div class="item-grid">{list.map(item => (<a href={`${base}/vanilla/items/${item._sanitizedId}/`}>{item.name}</a>))}</div>
        </section>
      ))}
    </div>
  ) : (
    <div class="item-grid">
      {catItems.map(item => (<a href={`${base}/vanilla/items/${item._sanitizedId}/`}>{item.name}</a>))}
    </div>
  )}

  <style>
    .book-layout {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .book-section {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 16px 20px;
    }
    .section-head {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 4px;
      padding-bottom: 8px;
      border-bottom: none !important;
      font-size: 1.1rem;
    }
    .section-icon { font-size: 18px; flex-shrink: 0; }
    .section-count {
      margin-left: auto;
      font-size: 13px;
      font-weight: 400;
      color: var(--c-text-3);
    }
    .sub-section {
      scroll-margin-top: 72px;
      margin-bottom: 8px;
    }
    .sub-section:last-child { margin-bottom: 0; }
    .sub-section .item-grid { margin: 4px 0 0; }
    .sub-head {
      font-size: 14px;
      font-weight: 600;
      margin: 8px 0 4px;
      color: var(--c-text-2);
    }
  </style>
</Layout>
