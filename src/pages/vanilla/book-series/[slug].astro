---
import Layout from '../../../layouts/Layout.astro';
import { loadData } from '../../../utils/data-loader';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  // All helpers must be inside getStaticPaths (Astro compiler restriction)
  const extractSeries = (chn) => chn.replace(/[ 　]*第\s*\d+\s*[卷册][\s\S]*$/, '').replace(/[ 　]*卷\s*\d+[\s\S]*$/, '').trim();
  const toSlug = (name) => name.replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fff-]/g, '');

  const { items, skills } = loadData();
  const books = items.filter(i => i.category === 'book');
  const skillMap = new Map(skills.map(s => [s.id, s]));

  const series = {};
  for (const b of books) {
    const sName = extractSeries(b.name || b.id);
    if (!series[sName]) series[sName] = [];
    series[sName].push(b);
  }

  return Object.entries(series)
    .filter(([, list]) => list.length > 1)
    .map(([name, list]) => {
      list.sort((a, b) => (a.name || a.id).localeCompare(b.name || b.id, 'zh'));

      // Find series prefix from first item: bookFiremansAlmanacHeat -> perkFiremansAlmanac
      const firstId = list[0].id;
      const skillPrefix = 'perk' + firstId.slice(4);
      // Find the common base by comparing with other items
      let commonPrefix = skillPrefix;
      for (const item of list) {
        const p = 'perk' + item.id.slice(4);
        let i = 0;
        while (i < commonPrefix.length && i < p.length && commonPrefix[i] === p[i]) i++;
        commonPrefix = commonPrefix.slice(0, i);
      }

      // Find completion perk: scan all skills for one that starts with the common prefix and ends with Complete
      const completePerk = skills.find(s => {
        const sid = s.id;
        return sid.startsWith(commonPrefix) && /Complete$/.test(sid) && sid !== skillPrefix;
      });

      const volumes = list.map(item => {
        const skillId = 'perk' + item.id.slice(4);
        const skill = skillMap.get(skillId);
        const effect = skill?.levels?.[0]?.effect || '';
        // Use description instead if effect is generic level label
        return {
          name: item.name || item.id,
          itemPath: `/vanilla/items/${item._sanitizedId}/`,
          effect: (effect && !/^[等级\s\d]+$/.test(effect)) ? effect : (skill?.description || ''),
        };
      });

      const completeName = completePerk?.name || '';
      const completeDesc = completePerk?.description || completePerk?.levels?.[0]?.effect || '';

      return {
        params: { slug: toSlug(name) },
        props: { seriesName: name, volumes, volumeCount: list.length, completeName, completeDesc },
      };
    });
}
const { seriesName, volumes, volumeCount, completeName, completeDesc } = Astro.props;
---

<Layout title={seriesName} description={`${seriesName} - ${volumeCount}卷`}>
  <nav class="breadcrumb">
    <a href={base}>首页</a><span class="sep">/</span>
    <a href={`${base}/vanilla/items/`}>物品列表</a><span class="sep">/</span>
    <a href={`${base}/vanilla/items/category/book/`}>书籍</a><span class="sep">/</span>
    <span>{seriesName}</span>
  </nav>
  <h1>{seriesName}</h1>
  <p class="subtitle">共 {volumeCount} 卷 · 全部阅读后可获得额外加成</p>

  <table>
    <caption style="caption-side:bottom;font-size:12px;color:var(--c-text-3);padding-top:4px;">{seriesName} 卷册列表</caption>
    <tr><th scope="col" class="col-num">#</th><th scope="col">名称</th><th scope="col">效果</th></tr>
    {volumes.map((v, i) => (
      <tr>
        <td class="col-num">{i + 1}</td>
        <td><a href={`${base}${v.itemPath}`}>{v.name}</a></td>
        <td>{v.effect || '-'}</td>
      </tr>
    ))}
  </table>

  {(completeName || completeDesc) && (
    <div class="info-card bonus-card">
      <div class="bonus-header">
        <span class="bonus-icon">🏆</span>
        <h2>全卷加成</h2>
      </div>
      <p class="bonus-name">
        <strong>{/^perk/.test(completeName) ? seriesName + ' 精通' : completeName}</strong>
      </p>
      <p class="bonus-desc">
        {completeDesc || '阅读全部 7 卷后解锁此强力加成。'}
      </p>
    </div>
  )}

  <style>
    .col-num {
      width: 48px;
      text-align: center;
    }
    .bonus-card {
      margin-top: 32px;
    }
    .bonus-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .bonus-header h2 {
      margin: 0;
      color: var(--c-blood);
      font-size: 1.15rem;
      border-bottom: none;
      display: block;
      padding: 0;
    }
    .bonus-icon {
      font-size: 24px;
      flex-shrink: 0;
    }
    .bonus-name {
      margin-bottom: 8px;
      font-size: 15px;
      color: var(--c-text);
    }
    .bonus-name strong {
      color: var(--c-blood);
    }
    .bonus-desc {
      margin-bottom: 0;
      font-size: 14px;
      color: var(--c-text-2);
      line-height: 1.7;
    }
  </style>
</Layout>
